rules_version = '2';

// Firestore security rules for Python Central Hub.
//
// Deploy with: npm run firebase:rules
//
// The web SDK config is client-visible by design, so these rules are the only
// thing standing between the database and the open internet. Default posture
// is deny; every allowance below is explicit.
service cloud.firestore {
  match /databases/{database}/documents {

    // A real account: Google, GitHub or email+password.
    //
    // Anonymous sessions are excluded on purpose. A guest's progress is kept
    // in their browser's localStorage and never sent here, so the database
    // only ever holds data belonging to a login its owner can get back into.
    // The client enforces the same rule; this is the half that cannot be
    // edited by whoever is holding the browser.
    function isAccount() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isAccount() && request.auth.uid == uid;
    }

    // Shape check for users/{uid}. Keeps a compromised or hand-rolled client
    // from stuffing arbitrary payloads into the profile document.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'uid', 'email', 'displayName', 'photoURL', 'locale',
               'providers', 'createdAt', 'updatedAt', 'settings'
             ])
             && d.uid == uid
             // The address must be the account's own (or empty, for a GitHub
             // login that shares none). Server code no longer mails this
             // field, but nothing should be able to plant someone else's.
             && (!('email' in d) || (d.email is string
                   && (d.email == '' || d.email == request.auth.token.email)))
             && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 80))
             && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 2048))
             && (!('locale' in d) || (d.locale is string && d.locale.size() <= 10))
             && (!('providers' in d) || (d.providers is list && d.providers.size() <= 10))
             && (!('createdAt' in d) || d.createdAt is timestamp)
             && (!('updatedAt' in d) || d.updatedAt is timestamp)
             && (!('settings' in d) || (d.settings is map
                   && d.settings.keys().hasOnly(['leaderboard', 'digest'])
                   && (!('leaderboard' in d.settings) || d.settings.leaderboard is bool)
                   && (!('digest' in d.settings) || d.settings.digest is bool)));
    }

    // Shapes of users/{uid}/stats/{name}, as src/lib/progress/sync.ts writes
    // them. Rules cannot measure a document's bytes, so the caps are on key
    // and list counts; Firestore's own 1 MiB document limit bounds the rest.
    // Writes are merges, so these check the document as it will be after the
    // write, not just the fields in it.
    function validStats(name) {
      let d = request.resource.data;
      return (name == 'bookmarks'
                && d.size() <= 8
                && (!('pages' in d) || (d.pages is list && d.pages.size() <= 2000)))
          || (name == 'summary'
                // A field cap rather than hasOnly: documents written by older
                // versions of the site may carry fields this one no longer
                // writes, and a merge keeps them, so hasOnly would lock those
                // learners out of syncing.
                && d.size() <= 16
                && (!('streak' in d) || d.streak is int)
                && (!('longest' in d) || d.longest is int)
                && (!('totalCompleted' in d) || d.totalCompleted is int)
                && (!('lastActive' in d) || (d.lastActive is string && d.lastActive.size() <= 10))
                && (!('enrolled' in d) || (d.enrolled is list && d.enrolled.size() <= 50)))
          // Maps keyed by an encoded page id (plus `#n` for quizzes and
          // exercises). One entry per page or per question block at most.
          || (name == 'quizzes' && d.size() <= 5000)
          || (name == 'exercises' && d.size() <= 10000)
          || (name == 'notes' && d.size() <= 2000);
    }

    // Contact + feedback form submissions.
    //
    // Append-only from the client: anyone may file one, nobody may read,
    // change or delete one. Submissions are never readable back, so a
    // sender's address is not exposed to the next visitor.
    //
    // The forms now go through app/api/submit-form, which verifies the
    // reCAPTCHA token before storing anything. These direct-create rules are
    // only the fallback for while that endpoint is unconfigured (see
    // src/lib/forms.ts). Once RECAPTCHA_SECRET and FIREBASE_SERVICE_ACCOUNT
    // are set on the deployment, change both `allow create` lines below to
    // `if false` and redeploy the rules -- that closes the spam hole.
    function validSubmission(fields) {
      let d = request.resource.data;
      return d.keys().hasOnly(fields)
             && d.keys().hasAll(['createdAt'])
             && d.createdAt is string
             && (!('email' in d) || (d.email is string && d.email.size() <= 254))
             && (!('recaptchaToken' in d) || d.recaptchaToken is string)
             && (!('page' in d) || (d.page is string && d.page.size() <= 512));
    }

    match /contact/{doc} {
      allow read, update, delete: if false;
      allow create: if validSubmission(
                         ['name', 'email', 'message', 'recaptchaToken', 'createdAt'])
                       && request.resource.data.name is string
                       && request.resource.data.name.size() <= 120
                       && request.resource.data.message is string
                       && request.resource.data.message.size() <= 5000;
    }

    match /feedback/{doc} {
      allow read, update, delete: if false;
      allow create: if validSubmission(
                         ['feedback', 'email', 'comment', 'page', 'recaptchaToken', 'createdAt'])
                       && request.resource.data.feedback is string
                       && request.resource.data.feedback.size() <= 40
                       && (!('comment' in request.resource.data)
                           || request.resource.data.comment.size() <= 5000);
    }

    // Learner profile. Readable and writable only by its owner.
    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(uid);
      allow delete: if isOwner(uid);

      // Per-course completion. Self-reported, so the owner writes it -- and
      // every server count of it keeps only ids that are real lessons of the
      // course (lib/server/admin.ts), so padding it buys nothing.
      match /progress/{course} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['completed', 'updatedAt'])
                              && request.resource.data.completed is list
                              && request.resource.data.completed.size() <= 1000;
      }

      // Bookmarks, quiz results, notes and the summary: the owner's own.
      // `certificates` is the index of issued certificates and is written
      // only by the issuing endpoint -- it used to be owner-writable, so a
      // learner could list certificates they never earned.
      match /stats/{name} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid)
                      && name in ['bookmarks', 'quizzes', 'notes', 'summary', 'exercises'];
        allow create, update: if isOwner(uid)
                              && name in ['bookmarks', 'quizzes', 'notes', 'summary', 'exercises']
                              && validStats(name);
      }
    }

    // Module page counts, seeded from the build manifest. Public because the
    // verification page needs it and it is the same data the site ships in
    // /progress-manifest.json anyway.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Exam questions WITHOUT their answers. Readable by a signed-in account
    // so the paper can be rendered; the key lives in examKeys and is
    // unreadable by anyone.
    match /exams/{module} {
      allow read: if isAccount();
      allow write: if false;
    }

    // Answer keys. No client may read these under any circumstances -- that
    // is the entire point of grading on the server.
    match /examKeys/{module} {
      allow read, write: if false;
    }

    // Graded attempts. The owner may see their own record; only the
    // grading endpoint (app/api/grade-exam) can write one.
    match /attempts/{id} {
      allow get: if isAccount() && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }

    // Issued certificates.
    //
    // `get` is public so anyone handed a certificate id can check it -- that
    // is what makes the certificate worth anything. `list` is denied so the
    // collection cannot be enumerated for holders' names. The document holds
    // no email address (it used to); a learner's own certificates are indexed
    // under users/{uid}/stats/certificates, which only the server writes.
    match /certificates/{certId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Public leaderboard.
    //
    // Readable and listable by anyone -- a board nobody can see is not a
    // board. Written only by app/api/publish-leaderboard, which
    // recomputes the numbers from server-side records: a self-reported
    // ranking would be worthless, since being wrong is the whole problem on
    // this particular surface. Opting out deletes the row rather than hiding
    // it.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Outbox for the "Trigger Email from Firestore" extension. Written by the
    // digest function, read by the extension, and off-limits to every client:
    // these documents contain subscribers' email addresses.
    match /mail/{doc} {
      allow read, write: if false;
    }

    // Anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

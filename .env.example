# Firebase web config.
#
# Next inlines NEXT_PUBLIC_* at build time; the old Astro names (PUBLIC_*)
# are not read any more.
#
# Optional. src/lib/firebase/config.ts falls back to the committed public
# values for the pythoncentralhub project, so the site builds without this
# file. Set these only to point the site at a different Firebase project.
#
# These are NOT secrets: Firebase publishes them in the client bundle. Access
# control lives in firebase/firestore.rules and the Firebase console's
# Authentication > Settings > Authorized domains list.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA v3 site key, used by the contact and feedback forms
# (components/learn/Contact.tsx, components/docs/Feedback.tsx).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# The primary address: what canonical links, the sitemap, the feed, link
# previews and emails point at. The site works on every address it is served
# on (python-central-hub.vercel.app and pythoncentralhub.live); this only picks
# which one search engines are told is the original.
#
# Leave it unset on Vercel: the project's production domain is used, which is
# the custom domain once one is attached and marked primary, and the
# .vercel.app address before that. Set it only to force a specific address.
NEXT_PUBLIC_SITE_URL=

# ---- Server only (Vercel project settings; never NEXT_PUBLIC_) -------------
# Used by the route handlers in app/api/. Without them those endpoints answer
# 503 "server/not-configured" and the site falls back where it can.
#
# Full service-account JSON: Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Paste as one line.
FIREBASE_SERVICE_ACCOUNT=
# Secret half of NEXT_PUBLIC_RECAPTCHA_SITE_KEY (reCAPTCHA v3), for the
# contact and feedback forms.
RECAPTCHA_SECRET=
# Any long random string; Vercel Cron sends it to /api/send-digest/.
CRON_SECRET=
# Digest email. With both set, /api/send-digest/ sends through Resend
# (resend.com; verify the sending domain there first). Without them it queues
# documents in Firestore `mail/` for the "Trigger Email from Firestore"
# extension instead.
RESEND_API_KEY=
EMAIL_FROM="Python Central Hub <hello@your-domain>"
# Optional. Every server and browser error is logged to the Vercel function
# log as `pythoncentralhub:error {...}`; set this to also POST each one as JSON to
# a Slack/Discord-compatible webhook or any collector.
ERROR_WEBHOOK_URL=
# Comma-separated addresses allowed to open /admin/ (verified accounts only).
ADMIN_EMAILS=
# Optional. Shared rate limits across every function instance (search, forms,
# error and CSP reports). Vercel's Upstash Redis integration sets both. Without
# them each instance keeps its own count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

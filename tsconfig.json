{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      // The repo has a `firebase/` directory of its own, which shadows the npm
      // package's subpaths (`firebase/auth`, `firebase/firestore`) under
      // baseUrl resolution. This mapping makes the package win.
      "firebase/*": [
        "node_modules/firebase/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".source/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".astro",
    ".vercel",
    // `src/` is not type-checked as a tree: it holds content, data and the
    // Python figure scripts. The modules the app imports from it (src/lib,
    // src/components/**/*.tsx) are still checked, because tsc follows imports.
    "src/**/*",
    "migration/**/*"
  ]
}

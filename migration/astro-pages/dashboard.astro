---
/**
 * /dashboard — everything the learner has done so far.
 *
 * Reads the local progress store first so the page is useful instantly and
 * without an account. If there is a signed-in session it then reconciles with
 * the cloud copy and repaints. Module totals come from
 * public/progress-manifest.json, generated by scripts/gen-progress-manifest.mjs.
 *
 * Layout note: the prompt markers down the left sit in one fixed gutter
 * (--pch-prompt-gutter), so they line up into a single column the way prompts
 * do in a REPL session. Keep new rows on that grid.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.dashTitle"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, follow" } }],
  }}
>
  <div class="pch-dash not-content" data-pch-dash>
    <p class="pch-dash__notice" data-pch-notice hidden></p>

    <section data-pch-continue-section hidden>
      <h2>{t("pch.dashContinue")}</h2>
      <a class="pch-dash__continue" data-pch-continue>
        <span class="pch-prompt" data-state="started" aria-hidden="true"></span>
        <span class="pch-dash__continue-module" data-pch-continue-module></span>
        <span class="pch-dash__continue-title" data-pch-continue-title></span>
      </a>
    </section>

    <ul class="pch-dash__stats">
      <li data-key="streak">
        <strong data-pch-stat="streak">0</strong><span>{t("pch.dashStreak")}</span>
      </li>
      <li data-key="longest">
        <strong data-pch-stat="longest">0</strong><span>{t("pch.dashLongest")}</span>
      </li>
      <li data-key="completed">
        <strong data-pch-stat="completed">0</strong><span>{t("pch.dashCompleted")}</span>
      </li>
      <li data-key="quizzes">
        <strong data-pch-stat="quizzes">0</strong><span>{t("pch.dashQuizzes")}</span>
      </li>
    </ul>

    <section class="pch-level" data-pch-level>
      <p class="pch-level__line">
        <span class="pch-level__num" data-pch-level-num>0</span>
        <span class="pch-level__label">{t("pch.levelLabel")}</span>
        <span class="pch-level__xp" data-pch-xp></span>
      </p>
      <span class="pch-dash__bar"><span class="pch-dash__bar-fill" data-pch-level-bar></span></span>
    </section>

    <h2>{t("pch.badgesTitle")}</h2>
    <ul class="pch-badges" data-pch-badges></ul>

    <h2>{t("pch.dashModules")}</h2>
    <p class="pch-dash__empty" data-pch-empty hidden>{t("pch.dashNoProgress")}</p>
    <ul class="pch-dash__modules" data-pch-modules></ul>

    <h2>{t("pch.dashBookmarks")}</h2>
    <p class="pch-dash__empty" data-pch-no-bookmarks hidden>{t("pch.dashNoBookmarks")}</p>
    <ul class="pch-dash__bookmarks" data-pch-bookmarks></ul>

    <p class="pch-dash__actions">
      <button type="button" class="pch-auth__secondary" data-pch-resync hidden>
        {t("pch.dashResync")}
      </button>
      <a class="pch-auth__secondary" href="/login?next=/dashboard" data-pch-signin hidden>
        {t("pch.authSignIn")}
      </a>
    </p>

    {/* Strings the script needs at runtime. */}
    <p hidden data-text-pages>{t("pch.dashPages")}</p>
    <p hidden data-text-exam>{t("pch.dashExam")}</p>
    <p hidden data-text-xp>{t("pch.levelXp")}</p>
    <p hidden data-badge="FirstPage">{t("pch.badgeFirstPage")}</p>
    <p hidden data-badge="TenPages">{t("pch.badgeTenPages")}</p>
    <p hidden data-badge="FiftyPages">{t("pch.badgeFiftyPages")}</p>
    <p hidden data-badge="HundredPages">{t("pch.badgeHundredPages")}</p>
    <p hidden data-badge="Quizzer">{t("pch.badgeQuizzer")}</p>
    <p hidden data-badge="WeekStreak">{t("pch.badgeWeekStreak")}</p>
    <p hidden data-badge="MonthStreak">{t("pch.badgeMonthStreak")}</p>
    <p hidden data-badge="ModuleDone">{t("pch.badgeModuleDone")}</p>
    <p hidden data-badge="Certified">{t("pch.badgeCertified")}</p>
    <p hidden data-text-localonly>{t("pch.dashLocalOnly")}</p>
    <p hidden data-text-syncing>{t("pch.dashSyncing")}</p>
    <p hidden data-text-synced>{t("pch.dashSynced")}</p>
  </div>
</StarlightPage>

<script>
  import { read, subscribe, getLastPage, type ProgressState } from "../lib/progress/local";
  import { moduleOf } from "../lib/progress/ids";
  import { tally, levelFor } from "../lib/progress/awards";
  import { readHint } from "../lib/auth/hint";

  interface ManifestModule {
    slug: string;
    label: string;
    count: number;
    hasExam?: boolean;
  }

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const text = (sel: string) => $(sel)?.textContent?.trim() ?? "";

  const dash = $("[data-pch-dash]");
  const notice = $("[data-pch-notice]");
  const modulesEl = $("[data-pch-modules]");
  const bookmarksEl = $("[data-pch-bookmarks]");

  let manifest: ManifestModule[] = [];
  /** Only the server issues certificates, so a guest always has zero. */
  let certificateCount = 0;
  const labelFor = (slug: string) =>
    manifest.find((m) => m.slug === slug)?.label ?? slug.replace(/-/g, " ");

  /** Turn "tutorials/python-lists/list-slicing" into "List slicing". */
  function titleOf(pageId: string): string {
    const last = pageId.split("/").pop() ?? pageId;
    const words = last.replace(/-/g, " ");
    return words.charAt(0).toUpperCase() + words.slice(1);
  }

  function paint(state: ProgressState = read()) {
    /* ---- headline numbers ---- */
    const completed = Object.values(state.modules).reduce((n, l) => n + l.length, 0);
    const stats: Record<string, number> = {
      streak: state.streak.count,
      longest: state.streak.longest,
      completed,
      quizzes: Object.keys(state.quizzes).length,
    };
    for (const [key, value] of Object.entries(stats)) {
      const el = $(`[data-pch-stat="${key}"]`);
      if (el) el.textContent = String(value);
    }

    /* ---- continue ---- */
    const last = getLastPage();
    const section = $("[data-pch-continue-section]");
    const cont = $<HTMLAnchorElement>("[data-pch-continue]");
    if (section && cont && last) {
      cont.href = last.href;
      const title = $("[data-pch-continue-title]");
      if (title) title.textContent = last.title || titleOf(last.pageId);
      const mod = $("[data-pch-continue-module]");
      if (mod) mod.textContent = labelFor(moduleOf(last.pageId));
      section.hidden = false;
    }

    /* ---- level and badges ---- */
    const counts = Object.fromEntries(manifest.map((m) => [m.slug, m.count]));
    const score = tally(state, counts, certificateCount);
    const { level, into, span } = levelFor(score.xp);

    const levelNum = $("[data-pch-level-num]");
    if (levelNum) levelNum.textContent = String(level);
    const xpEl = $("[data-pch-xp]");
    if (xpEl) xpEl.textContent = `${score.xp} ${text("[data-text-xp]")}`;
    const levelBar = $("[data-pch-level-bar]");
    if (levelBar) levelBar.style.setProperty("--pch-fill", `${Math.round((into / span) * 100)}%`);

    const badgesEl = $("[data-pch-badges]");
    if (badgesEl) {
      badgesEl.innerHTML = "";
      for (const badge of score.badges) {
        const li = document.createElement("li");
        li.className = "pch-badge";
        li.dataset.earned = String(badge.earned);
        // Locked badges still show their target, so the list reads as a set of
        // things to aim at rather than a wall of blanks.
        li.title = `${badge.have} / ${badge.need}`;
        li.textContent =
          document.querySelector(`[data-badge="${badge.id}"]`)?.textContent?.trim() ?? badge.id;
        badgesEl.appendChild(li);
      }
    }

    /* ---- module ladder ---- */
    const empty = $("[data-pch-empty]");
    if (empty) empty.hidden = completed > 0;

    if (modulesEl) {
      const pages = text("[data-text-pages]");
      modulesEl.innerHTML = "";

      for (const mod of manifest) {
        const done = (state.modules[mod.slug] ?? []).length;
        // Guard against a page renamed since its id was stored: a stale id
        // would otherwise push the bar past 100%.
        const pct = mod.count ? Math.min(100, Math.round((done / mod.count) * 100)) : 0;

        const li = document.createElement("li");
        li.className = "pch-dash__module";
        li.dataset.started = String(done > 0);
        li.innerHTML = `
          <span class="pch-prompt" aria-hidden="true"></span>
          <a class="pch-dash__module-name" href="/${mod.slug}"></a>
          <span class="pch-dash__module-count"></span>
          <span class="pch-dash__bar"><span class="pch-dash__bar-fill"></span></span>`;

        // The exam link shows whenever a module has one. Sitting it early is
        // allowed -- only the certificate needs 90% of the pages, and the
        // server says so in its own words if they claim too soon.
        if (mod.hasExam) {
          const exam = document.createElement("a");
          exam.className = "pch-dash__module-exam";
          exam.href = `/exam/${mod.slug}`;
          exam.textContent = text("[data-text-exam]");
          li.appendChild(exam);
        }

        li.querySelector<HTMLElement>(".pch-prompt")!.dataset.state =
          pct === 100 ? "done" : done > 0 ? "started" : "";
        li.querySelector<HTMLAnchorElement>(".pch-dash__module-name")!.textContent = mod.label;
        li.querySelector<HTMLElement>(".pch-dash__module-count")!.textContent =
          `${done} / ${mod.count} ${pages}`;
        li.querySelector<HTMLElement>(".pch-dash__bar-fill")!.style.setProperty(
          "--pch-fill",
          `${pct}%`
        );
        modulesEl.appendChild(li);
      }
    }

    /* ---- bookmarks ---- */
    const noBookmarks = $("[data-pch-no-bookmarks]");
    if (noBookmarks) noBookmarks.hidden = state.bookmarks.length > 0;

    if (bookmarksEl) {
      bookmarksEl.innerHTML = "";
      for (const pageId of state.bookmarks) {
        const li = document.createElement("li");
        li.innerHTML = `<span class="pch-prompt" aria-hidden="true"></span><a></a>`;
        const a = li.querySelector("a")!;
        a.href = `/${pageId}`;
        a.textContent = titleOf(pageId);
        bookmarksEl.appendChild(li);
      }
    }

    // The bars start at zero width and fill once, together, on the frame
    // after the first paint. Re-painting later does not replay it.
    if (dash && !dash.classList.contains("pch-dash--ready")) {
      requestAnimationFrame(() => dash.classList.add("pch-dash--ready"));
    }
  }

  /** How many certificates this learner holds, from their own index doc. */
  async function countCertificates(): Promise<number> {
    try {
      const { currentUser } = await import("../lib/firebase/auth");
      const user = await currentUser();
      if (!user || user.isAnonymous) return 0;

      const { doc, getDoc } = await import("firebase/firestore");
      const { getDb } = await import("../lib/firebase/client");
      const snap = await getDoc(doc(await getDb(), "users", user.uid, "stats", "certificates"));
      return ((snap.data()?.items ?? []) as unknown[]).length;
    } catch {
      return 0;
    }
  }

  /* ---- boot ---- */
  (async () => {
    try {
      const res = await fetch("/progress-manifest.json");
      if (res.ok) manifest = ((await res.json()).modules ?? []) as ManifestModule[];
    } catch {
      /* the page still works without module totals */
    }

    paint();
    subscribe(paint);

    const hint = readHint();
    const resync = $<HTMLButtonElement>("[data-pch-resync]");
    const signin = $("[data-pch-signin]");

    // Guests are complete as they are: their progress lives in this browser
    // and there is nothing in the cloud to reconcile with. Say so plainly and
    // offer the upgrade, rather than silently showing a device-local view.
    if (!hint || hint.anon) {
      if (notice) {
        notice.textContent = text("[data-text-localonly]");
        notice.hidden = false;
      }
      if (signin) signin.hidden = false;
      return;
    }

    if (resync) resync.hidden = false;

    const sync = async () => {
      if (notice) {
        notice.textContent = text("[data-text-syncing]");
        notice.hidden = false;
      }
      try {
        const { hydrateOnce } = await import("../lib/progress/sync");
        const merged = await hydrateOnce();
        certificateCount = await countCertificates();
        paint(merged);
        if (notice) notice.textContent = text("[data-text-synced]");
      } catch (err) {
        console.warn("[dashboard] sync failed:", err);
        if (notice) notice.hidden = true;
      }
    };

    await sync();

    resync?.addEventListener("click", async () => {
      resync.disabled = true;
      try {
        const { resync: pull } = await import("../lib/progress/sync");
        paint(await pull());
      } finally {
        resync.disabled = false;
      }
    });
  })();
</script>

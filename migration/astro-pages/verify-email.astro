---
/**
 * /verify-email — where a new account lands after signing up.
 *
 * Verification is not a wall: every tutorial stays readable without it. It
 * gates certificate issuance only, so that a certificate names an address its
 * holder actually controls.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AuthMessages from "../components/auth/AuthMessages.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.authVerifyTitle"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, follow" } }],
  }}
>
  <div class="pch-auth not-content">
    <p class="pch-auth__intro" data-pch-intro>{t("pch.authVerifyIntro")}</p>

    <button type="button" class="pch-auth__submit" data-pch-resend>
      {t("pch.authVerifyResend")}
    </button>

    <p class="pch-auth__status" data-pch-status hidden></p>

    <p class="pch-auth__alt">
      <a href="/profile">{t("pch.authProfile")}</a>
    </p>

    <p hidden data-pch-sent>{t("pch.authVerifySent")}</p>
    <p hidden data-pch-done>{t("pch.authVerifyDone")}</p>
    <p hidden data-pch-signedout>{t("pch.authSignedOutNotice")}</p>

    <AuthMessages />
  </div>
</StarlightPage>

<script>
  import { messageFor, setStatus } from "../lib/auth/messages";

  const resend = document.querySelector<HTMLButtonElement>("[data-pch-resend]");
  const status = document.querySelector<HTMLElement>("[data-pch-status]");
  const text = (sel: string) =>
    document.querySelector<HTMLElement>(sel)?.textContent?.trim() ?? "";

  (async () => {
    const { currentUser } = await import("../lib/firebase/auth");
    const user = await currentUser();

    if (!user || user.isAnonymous) {
      if (resend) resend.hidden = true;
      setStatus(status, text("[data-pch-signedout]"), "error");
      return;
    }
    // reload() refreshes emailVerified, which the cached User object would
    // otherwise keep reporting as false after the learner clicked the link in
    // another tab.
    await user.reload();
    if (user.emailVerified) {
      if (resend) resend.hidden = true;
      setStatus(status, text("[data-pch-done]"), "success");
    }
  })();

  resend?.addEventListener("click", async () => {
    resend.disabled = true;
    setStatus(status, null);
    try {
      const { sendVerification } = await import("../lib/firebase/auth");
      await sendVerification();
      setStatus(status, text("[data-pch-sent]"), "success");
    } catch (err) {
      const { authErrorKey } = await import("../lib/firebase/auth");
      setStatus(status, messageFor(authErrorKey(err)), "error");
      resend.disabled = false;
    }
  });
</script>

---
/**
 * /login — sign in with Google, GitHub or an email address.
 *
 * The site is statically generated, so there is no server-side session: the
 * page renders identically for everyone and the script decides what to do
 * once Firebase has restored the session in the browser.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AuthProviders from "../components/auth/AuthProviders.astro";
import AuthMessages from "../components/auth/AuthMessages.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.authLoginTitle"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, follow" } }],
  }}
>
  <div class="pch-auth not-content">
    <p class="pch-auth__intro">{t("pch.authLoginIntro")}</p>

    <AuthProviders />

    <form id="pch-login-form" novalidate>
      <div class="pch-auth__field">
        <label for="pch-login-email">{t("pch.authEmail")}</label>
        <input id="pch-login-email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="pch-auth__field">
        <label for="pch-login-password">{t("pch.authPassword")}</label>
        <input
          id="pch-login-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="pch-auth__submit" data-pch-submit>
        {t("pch.authLoginSubmit")}
      </button>
    </form>

    <p class="pch-auth__status" data-pch-status hidden></p>

    <p class="pch-auth__alt">
      <a href="/reset-password">{t("pch.authForgot")}</a>
    </p>
    <p class="pch-auth__alt">
      {t("pch.authNoAccount")} <a href="/signup">{t("pch.authCreateAccount")}</a>
    </p>

    <AuthMessages />
  </div>
</StarlightPage>

<script>
  import { messageFor, setStatus, nextUrl } from "../lib/auth/messages";

  const form = document.getElementById("pch-login-form") as HTMLFormElement | null;
  const status = document.querySelector<HTMLElement>("[data-pch-status]");
  const submit = document.querySelector<HTMLButtonElement>("[data-pch-submit]");

  /**
   * Fold any progress collected before signing in into the account.
   *
   * Best-effort: a failed merge must never block the redirect, because the
   * sign-in itself already succeeded and the local copy is still intact.
   */
  const mergeProgress = async () => {
    try {
      const { resync } = await import("../lib/progress/sync");
      await resync();
    } catch (err) {
      console.warn("[auth] progress merge deferred:", err);
    }
  };

  if (form) {
    /** Disable the form while a request is in flight. */
    const busy = (on: boolean) => {
      if (submit) submit.disabled = on;
      form.querySelectorAll("input").forEach((i) => (i.disabled = on));
      document
        .querySelectorAll<HTMLButtonElement>("[data-pch-oauth]")
        .forEach((b) => (b.disabled = on));
    };

    /* ---- email + password ---- */
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setStatus(status, null);

      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const password = (form.elements.namedItem("password") as HTMLInputElement).value;
      if (!email || !password) {
        setStatus(status, messageFor("pch.authErrRequired"), "error");
        return;
      }

      busy(true);
      try {
        const { signInWithEmail } = await import("../lib/firebase/auth");
        await signInWithEmail(email, password);
        await mergeProgress();
        window.location.href = nextUrl();
      } catch (err) {
        const { authErrorKey } = await import("../lib/firebase/auth");
        setStatus(status, messageFor(authErrorKey(err)), "error");
        busy(false);
      }
    });

    /* ---- OAuth ---- */
    document.querySelectorAll<HTMLButtonElement>("[data-pch-oauth]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        setStatus(status, null);
        busy(true);
        try {
          const auth = await import("../lib/firebase/auth");
          const cred =
            btn.dataset.pchOauth === "google"
              ? await auth.signInWithGoogle()
              : await auth.signInWithGithub();
          // A null credential means the popup was unavailable and a full-page
          // redirect is already under way, so leave the UI as it is.
          if (cred) {
            await mergeProgress();
            window.location.href = nextUrl();
          }
        } catch (err) {
          const { authErrorKey } = await import("../lib/firebase/auth");
          setStatus(status, messageFor(authErrorKey(err)), "error");
          busy(false);
        }
      });
    });

    /* ---- returning from a redirect sign-in ---- */
    (async () => {
      try {
        const { completeRedirectSignIn } = await import("../lib/firebase/auth");
        if (await completeRedirectSignIn()) {
          await mergeProgress();
          window.location.href = nextUrl();
        }
      } catch (err) {
        const { authErrorKey } = await import("../lib/firebase/auth");
        setStatus(status, messageFor(authErrorKey(err)), "error");
      }
    })();
  }
</script>

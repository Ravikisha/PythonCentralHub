---
/**
 * /signup — create an account.
 *
 * Signing up while an anonymous session exists links the credential to that
 * same uid (see signUpWithEmail), so progress collected before registering
 * survives. The verification email is sent automatically; certificates are
 * gated on it, reading is not.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AuthProviders from "../components/auth/AuthProviders.astro";
import AuthMessages from "../components/auth/AuthMessages.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.authSignupTitle"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, follow" } }],
  }}
>
  <div class="pch-auth not-content">
    <p class="pch-auth__intro">{t("pch.authSignupIntro")}</p>

    <AuthProviders />

    <form id="pch-signup-form" novalidate>
      <div class="pch-auth__field">
        <label for="pch-signup-name">{t("pch.authName")}</label>
        <input id="pch-signup-name" name="name" type="text" autocomplete="name" />
      </div>

      <div class="pch-auth__field">
        <label for="pch-signup-email">{t("pch.authEmail")}</label>
        <input id="pch-signup-email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="pch-auth__field">
        <label for="pch-signup-password">{t("pch.authPassword")}</label>
        <input
          id="pch-signup-password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <span class="pch-auth__hint">{t("pch.authPasswordHint")}</span>
      </div>

      <button type="submit" class="pch-auth__submit" data-pch-submit>
        {t("pch.authSignupSubmit")}
      </button>
    </form>

    <p class="pch-auth__status" data-pch-status hidden></p>

    <p class="pch-auth__alt">
      {t("pch.authHaveAccount")} <a href="/login">{t("pch.authSignIn")}</a>
    </p>

    <AuthMessages />
  </div>
</StarlightPage>

<script>
  import { messageFor, setStatus, nextUrl } from "../lib/auth/messages";

  const form = document.getElementById("pch-signup-form") as HTMLFormElement | null;
  const status = document.querySelector<HTMLElement>("[data-pch-status]");
  const submit = document.querySelector<HTMLButtonElement>("[data-pch-submit]");

  /**
   * Fold any progress collected before signing in into the account.
   *
   * Best-effort: a failed merge must never block the redirect, because the
   * sign-in itself already succeeded and the local copy is still intact.
   */
  const mergeProgress = async () => {
    try {
      const { resync } = await import("../lib/progress/sync");
      await resync();
    } catch (err) {
      console.warn("[auth] progress merge deferred:", err);
    }
  };

  if (form) {
    const busy = (on: boolean) => {
      if (submit) submit.disabled = on;
      form.querySelectorAll("input").forEach((i) => (i.disabled = on));
      document
        .querySelectorAll<HTMLButtonElement>("[data-pch-oauth]")
        .forEach((b) => (b.disabled = on));
    };

    const show = async (err: unknown) => {
      const { authErrorKey } = await import("../lib/firebase/auth");
      setStatus(status, messageFor(authErrorKey(err)), "error");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setStatus(status, null);

      const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const password = (form.elements.namedItem("password") as HTMLInputElement).value;

      if (!email || !password) {
        setStatus(status, messageFor("pch.authErrRequired"), "error");
        return;
      }
      // Checked here as well as by Firebase so the message matches the hint
      // under the field rather than the SDK's own 6-character minimum.
      if (password.length < 8) {
        setStatus(status, messageFor("pch.authErrWeakPassword"), "error");
        return;
      }

      busy(true);
      try {
        const { signUpWithEmail } = await import("../lib/firebase/auth");
        await signUpWithEmail(email, password, name || undefined);
        await mergeProgress();
        window.location.href = "/verify-email";
      } catch (err) {
        await show(err);
        busy(false);
      }
    });

    document.querySelectorAll<HTMLButtonElement>("[data-pch-oauth]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        setStatus(status, null);
        busy(true);
        try {
          const auth = await import("../lib/firebase/auth");
          const cred =
            btn.dataset.pchOauth === "google"
              ? await auth.signInWithGoogle()
              : await auth.signInWithGithub();
          if (cred) {
            await mergeProgress();
            window.location.href = nextUrl();
          }
        } catch (err) {
          await show(err);
          busy(false);
        }
      });
    });

    (async () => {
      try {
        const { completeRedirectSignIn } = await import("../lib/firebase/auth");
        if (await completeRedirectSignIn()) {
          await mergeProgress();
          window.location.href = nextUrl();
        }
      } catch (err) {
        await show(err);
      }
    })();
  }
</script>

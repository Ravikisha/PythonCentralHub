{
  "name": "pythoncentralhub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "check": "cross-env NODE_OPTIONS=--max-old-space-size=4096 astro check",
    "preview": "astro preview",
    "astro": "astro",
    "figures": "python scripts/figures/build.py",
    "mdxcheck": "node scripts/mdxcheck.mjs",
    "deploy": "bash deploy.sh",
    "dsa:harvest": "node scripts/extract-problems.mjs > src/data/dsa/problems.generated.yaml",
    "dsa:merge": "node scripts/merge-sheets.mjs",
    "dsa:validate": "node scripts/validate-problems.mjs",
    "dsa:audit": "node scripts/audit-dsa.mjs",
    "dsa:syllabus": "node scripts/gen-dsa-syllabus.mjs",
    "dsa:recall": "node scripts/gen-recall-deck.mjs",
    "dsa:lint": "node scripts/lint-dsa-mdx.mjs",
    "dsa:p5": "node scripts/lint-p5.mjs",
    "viz:coverage": "node scripts/viz-coverage.mjs",
    "viz:mermaid": "node scripts/lint-mermaid.mjs",
    "mml:recall": "node scripts/gen-mml-recall.mjs",
    "mml:mdx": "node scripts/mdxcheck.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "mml:asides": "node scripts/lint-asides.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:asides": "node scripts/lint-asides.mjs",
    "mml:links": "node scripts/lint-doc-links.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:links": "node scripts/lint-doc-links.mjs",
    "dsa": "npm run dsa:harvest && npm run dsa:merge && npm run dsa:syllabus && npm run dsa:recall && npm run dsa:validate && npm run dsa:lint && npm run dsa:p5 && npm run dsa:audit",
    "mml:math": "node scripts/lint-math.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:math": "node scripts/lint-math.mjs",
    "mml": "npm run mml:mdx && npm run mml:math && npm run mml:asides && npm run mml:links && npm run mml:recall && npm run dsa:p5 && npm run viz:mermaid"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "astro-robots-txt": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "js-yaml": "^4.1.0",
    "motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.4",
    "shiki": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "rehype-pretty-code": "^0.14.5"
  }
}

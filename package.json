{
  "name": "pythoncentralhub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "npm run assets:sync && npm run progress:manifest && npm run search:index && next build",
    "progress:manifest": "node scripts/gen-progress-manifest.mjs",
    "figures": "python scripts/figures/build.py && node scripts/rasterize-figures.mjs",
    "mdxcheck": "node scripts/mdxcheck.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "deploy": "npx vercel deploy --prod",
    "deploy:preview": "npx vercel deploy",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "firebase:indexes": "firebase deploy --only firestore:indexes",
    "exams:check": "node scripts/seed-exams.mjs --dry",
    "exams:seed": "node scripts/seed-exams.mjs",
    "dsa:harvest": "node scripts/extract-problems.mjs > src/data/dsa/problems.generated.yaml",
    "dsa:merge": "node scripts/merge-sheets.mjs",
    "dsa:validate": "node scripts/validate-problems.mjs",
    "dsa:audit": "node scripts/audit-dsa.mjs",
    "dsa:syllabus": "node scripts/gen-dsa-syllabus.mjs",
    "dsa:recall": "node scripts/gen-recall-deck.mjs",
    "dsa:lint": "node scripts/lint-dsa-mdx.mjs",
    "dsa:p5": "node scripts/lint-p5.mjs",
    "viz:coverage": "node scripts/viz-coverage.mjs",
    "viz:mermaid": "node scripts/lint-mermaid.mjs",
    "svg:optimize": "svgo --config svgo.config.mjs -r -f public/images",
    "svg:pixdiff": "node scripts/svg-pixdiff.mjs",
    "mml:recall": "node scripts/gen-mml-recall.mjs",
    "mml:mdx": "node scripts/mdxcheck.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "mml:gfm": "node scripts/mdxcheck-gfm.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "mml:frontmatter": "node scripts/lint-frontmatter.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "mml:asides": "node scripts/lint-asides.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:asides": "node scripts/lint-asides.mjs",
    "mml:links": "node scripts/lint-doc-links.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:links": "node scripts/lint-doc-links.mjs",
    "dsa": "npm run dsa:harvest && npm run dsa:merge && npm run dsa:syllabus && npm run dsa:recall && npm run dsa:validate && npm run dsa:lint && npm run dsa:p5 && npm run dsa:audit",
    "mml:math": "node scripts/lint-math.mjs \"src/content/docs/Mathematics for Machine Learning\"",
    "lint:math": "node scripts/lint-math.mjs",
    "mml": "npm run mml:mdx && npm run mml:gfm && npm run mml:frontmatter && npm run mml:math && npm run mml:asides && npm run mml:links && npm run mml:recall && npm run dsa:p5 && npm run viz:mermaid",
    "typecheck": "tsc --noEmit",
    "routes:verify": "node scripts/verify-routes.mjs",
    "search:index": "node scripts/gen-search-index.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "assets:sync": "node scripts/sync-content-assets.mjs",
    "content:check": "node scripts/check-mdx.mjs --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-pythoncentralhub \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "playwright test",
    "test:e2e:full": "npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-pythoncentralhub \"playwright test\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fumadocs/satteri": "^0.5.1",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^11.18.2",
    "fumadocs-core": "^16.15.13",
    "fumadocs-mdx": "^15.4.3",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satteri": "^0.10.5",
    "sharp": "^0.34.4",
    "shiki": "^4.0.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.63",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.30.2",
    "jsdom": "^26.1.0",
    "rehype-pretty-code": "^0.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7"
  }
}

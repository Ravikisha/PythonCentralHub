---
// reCAPTCHA v3 site key (optional). Exposed to the client only when set.
// Set PUBLIC_RECAPTCHA_SITE_KEY in your environment to enable bot protection.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<section class="bg-white dark:bg-gray-900">
  <div class="px-4 mx-auto max-w-screen-md">
    <p
      class="mb-8 lg:mb-16 font-light text-center text-gray-500 dark:text-gray-400 sm:text-xl"
    >
      Got a technical issue? Want to give us feedback? Any questions? Any
      Suggestions? We'd love to hear from you. Send us a message and we'll
      respond as soon as possible.
    </p>
    <noscript>
      <p
        class="mb-6 p-3 rounded-lg text-center text-sm bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200"
      >
        This contact form requires JavaScript to be enabled. Please enable
        JavaScript, or email us directly at
        <a class="underline" href="mailto:ravikishan63392@gmail.com"
          >ravikishan63392@gmail.com</a
        >.
      </p>
    </noscript>
    <form
      class="space-y-8"
      id="contactForm"
      method="POST"
      data-recaptcha-key={recaptchaSiteKey ?? ""}
    >
      <div>
        <label
          for="email"
          class="block mb-2 text-lg font-bold font-poppins text-gray-900 dark:text-gray-300"
          >Your email <span class="text-red-500" aria-hidden="true">*</span></label
        >
        <input
          type="email"
          id="email"
          name="email"
          aria-required="true"
          class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500 dark:shadow-sm-light"
          placeholder="you@example.com"
          required
        />
      </div>
      <div>
        <label
          for="name"
          class="block mb-2 text-lg font-bold font-poppins text-gray-900 dark:text-gray-300"
          >Name <span class="text-red-500" aria-hidden="true">*</span></label
        >
        <input
          type="text"
          id="name"
          name="name"
          aria-required="true"
          class="block p-3 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 shadow-sm focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500 dark:shadow-sm-light"
          placeholder="Your full name"
          required
        />
      </div>
      <div class="sm:col-span-2">
        <label
          for="message"
          class="block mb-2 text-lg font-bold font-poppins text-gray-900 dark:text-gray-300"
          >Your message <span class="text-red-500" aria-hidden="true">*</span></label
        >
        <textarea
          id="message"
          rows="6"
          name="message"
          aria-required="true"
          class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg shadow-sm border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500"
          placeholder="Describe your issue, question, or feedback..."
          required></textarea>
      </div>
      <div id="contactFormError" role="alert" aria-live="polite" class="sr-only"></div>
      <button
        id="contactSubmit"
        type="submit"
        class="inline-flex items-center justify-center gap-2 py-3 px-5 text-sm font-medium text-center text-gray-900 dark:text-white rounded-lg bg-primary-700 sm:w-fit hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span
          id="contactSpinner"
          class="hidden w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"
          aria-hidden="true"></span>
        <span id="contactSubmitText">Send message</span>
      </button>
    </form>
  </div>
</section>

{recaptchaSiteKey && (
  <script
    is:inline
    src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
    async
  />
)}

<script type="module">
  // Import the functions you need from the SDKs you need
  // @ts-ignore
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.2/firebase-app.js";
  // @ts-ignore
  import { getAnalytics } from "https://www.gstatic.com/firebasejs/10.7.2/firebase-analytics.js";
  // @ts-ignore
  import { getFirestore, doc, setDoc} from "https://www.gstatic.com/firebasejs/10.7.2/firebase-firestore.js";
  // TODO: Add SDKs for Firebase products that you want to use
  // https://firebase.google.com/docs/web/setup#available-libraries

  // Your web app's Firebase configuration
  // For Firebase JS SDK v7.20.0 and later, measurementId is optional
  const firebaseConfig = {
    apiKey: "AIzaSyC9JRAi_fsezHf8PN-8A4tSoZYJmThEiAk",
    authDomain: "pythoncentralhub.firebaseapp.com",
    projectId: "pythoncentralhub",
    storageBucket: "pythoncentralhub.appspot.com",
    messagingSenderId: "479368830014",
    appId: "1:479368830014:web:87a5f98745df11c788056f",
    measurementId: "G-58ZCKY0YPD",
  };

  // Initialize Firebase
  const app = initializeApp(firebaseConfig);
  const analytics = getAnalytics(app);

  const db = getFirestore(app);

  function uuidv4() {
    if (typeof crypto !== "undefined" && crypto.randomUUID) {
      return crypto.randomUUID();
    }
    // Fallback for very old browsers.
    return Date.now().toString(36) + Math.random().toString(36).slice(2);
  }

  // @ts-ignore
  const form = document.getElementById("contactForm");
  // @ts-ignore
  const submitBtn = document.getElementById("contactSubmit");
  // @ts-ignore
  const spinner = document.getElementById("contactSpinner");
  // @ts-ignore
  const submitText = document.getElementById("contactSubmitText");
  // @ts-ignore
  const errorRegion = document.getElementById("contactFormError");
  // @ts-ignore
  const recaptchaKey = form ? form.dataset.recaptchaKey : "";

  // Notify the user via toast (if available) and the aria-live region.
  // @ts-ignore
  function notify(title, description, variant) {
    // @ts-ignore
    if (window.toast && typeof window.toast.show === "function") {
      // @ts-ignore
      window.toast.show({ title, description, variant });
    }
    if (errorRegion) {
      // @ts-ignore
      errorRegion.textContent = description || title;
    }
  }

  // @ts-ignore
  function setLoading(isLoading) {
    if (!submitBtn || !spinner || !submitText) return;
    // @ts-ignore
    submitBtn.disabled = isLoading;
    spinner.classList.toggle("hidden", !isLoading);
    // @ts-ignore
    submitText.textContent = isLoading ? "Sending..." : "Send message";
  }

  // Fetch a reCAPTCHA v3 token (empty string if not configured/available).
  // @ts-ignore
  async function getRecaptchaToken() {
    // @ts-ignore
    if (!recaptchaKey || !window.grecaptcha) return "";
    try {
      // @ts-ignore
      await new Promise((resolve) => window.grecaptcha.ready(resolve));
      // @ts-ignore
      return await window.grecaptcha.execute(recaptchaKey, { action: "contact" });
    } catch {
      return "";
    }
  }

  // Function to get form values
  // @ts-ignore
  function getInputVal(id) {
    const element = document.getElementById(id);
    // @ts-ignore
    return element.value;
  }

  // Save message to firebase
  // @ts-ignore
  async function saveMessage(name, email, message, recaptchaToken) {
    await setDoc(doc(db, "contact", uuidv4()), {
      name: name,
      email: email,
      message: message,
      recaptchaToken: recaptchaToken,
      createdAt: new Date().toISOString(),
    });
  }

  // Submit form
  // @ts-ignore
  async function submitForm(e) {
    e.preventDefault();
    if (errorRegion) errorRegion.textContent = "";
    setLoading(true);

    try {
      const name = getInputVal("name");
      const email = getInputVal("email");
      const message = getInputVal("message");
      const recaptchaToken = await getRecaptchaToken();

      await saveMessage(name, email, message, recaptchaToken);

      notify(
        "Message sent",
        "Thank you for your message! We will get back to you as soon as possible.",
        "success"
      );
      // @ts-ignore
      if (form) form.reset();
    } catch (err) {
      console.error("[contact] submit failed:", err);
      notify(
        "Something went wrong",
        "We couldn't send your message. Please try again later.",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }

  // Listen for form submit
  // @ts-ignore
  if (form) form.addEventListener("submit", submitForm);
</script>

---
/**
 * Adds the account menu to the right-hand side of the site header.
 *
 * Overriding `SocialIcons` rather than `Header` on purpose: Starlight's header
 * is a three-column grid whose sizing is tuned against its own children, and
 * this slot already sits exactly where an account control belongs. Wrapping
 * the default keeps every existing social link untouched.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import UserMenu from "./UserMenu.astro";
---

<Default><slot /></Default>
<UserMenu />

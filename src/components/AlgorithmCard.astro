---
/**
 * AlgorithmCard — the standard at-a-glance summary that closes every
 * algorithm page in the Machine Learning module.
 *
 * One consistent shape across ~40 pages means a reader can compare KNN against
 * SVM against Random Forest without re-reading the prose.
 *
 * Usage in MDX:
 *
 * <AlgorithmCard
 *   name="Logistic Regression"
 *   type="Supervised · Classification"
 *   sklearn="sklearn.linear_model.LogisticRegression"
 *   assumptions={["Log-odds are linear in the features", "Observations are independent"]}
 *   complexity={{ train: "O(n·d·i)", predict: "O(d)", memory: "O(d)" }}
 *   hyperparams={[
 *     { name: "C", effect: "Inverse regularization strength — lower C means stronger penalty." },
 *   ]}
 *   useWhen={["You need calibrated probabilities", "The decision boundary is roughly linear"]}
 *   avoidWhen={["Features interact non-linearly and you cannot engineer those terms"]}
 * />
 */
export interface Hyperparam {
  name: string;
  effect: string;
  /** Optional default value, rendered as a monospace chip. */
  default?: string;
}

export interface Complexity {
  /** Training cost, e.g. "O(n·d²)". */
  train?: string;
  /** Per-instance prediction cost. */
  predict?: string;
  /** Memory held by the fitted model. */
  memory?: string;
}

export interface Props {
  /** Algorithm name, e.g. "K-Means". */
  name: string;
  /** Short taxonomy line, e.g. "Unsupervised · Clustering". */
  type?: string;
  /** Fully qualified scikit-learn class (or other library entry point). */
  sklearn?: string;
  /** What the algorithm assumes about the data. */
  assumptions?: string[];
  complexity?: Complexity;
  /** The handful of hyperparameters that actually matter. */
  hyperparams?: Hyperparam[];
  useWhen?: string[];
  avoidWhen?: string[];
  /** Notation legend: n = samples, d = features, unless overridden. */
  notation?: string;
}

const {
  name,
  type,
  sklearn,
  assumptions = [],
  complexity,
  hyperparams = [],
  useWhen = [],
  avoidWhen = [],
  notation = "n = samples, d = features, i = iterations",
} = Astro.props;

const hasComplexity =
  !!complexity && !!(complexity.train || complexity.predict || complexity.memory);

const t = Astro.locals.t;
---

<section class="pch-algo" aria-label={`${name} summary card`}>
  <div class="pch-viz__bar">
    <span class="pch-viz__tag">{t("pch.algoTag")}</span>
    <span class="pch-viz__title">{name}</span>
    {type && <span class="pch-algo__type">{type}</span>}
  </div>

  <div class="pch-algo__body">
    {sklearn && (
      <p class="pch-algo__api">
        <span class="pch-algo__api-label">{t("pch.algoApi")}</span>
        <code>{sklearn}</code>
      </p>
    )}

    {assumptions.length > 0 && (
      <div class="pch-algo__block">
        <h4 class="pch-algo__h">{t("pch.algoAssumes")}</h4>
        <ul>
          {assumptions.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
      </div>
    )}

    {hasComplexity && (
      <div class="pch-algo__block">
        <h4 class="pch-algo__h">{t("pch.algoCost")}</h4>
        <dl class="pch-algo__cost">
          {complexity!.train && (
            <div>
              <dt>{t("pch.algoTrain")}</dt>
              <dd><code>{complexity!.train}</code></dd>
            </div>
          )}
          {complexity!.predict && (
            <div>
              <dt>{t("pch.algoPredict")}</dt>
              <dd><code>{complexity!.predict}</code></dd>
            </div>
          )}
          {complexity!.memory && (
            <div>
              <dt>{t("pch.algoMemory")}</dt>
              <dd><code>{complexity!.memory}</code></dd>
            </div>
          )}
        </dl>
        <p class="pch-algo__notation">{notation}</p>
      </div>
    )}

    {hyperparams.length > 0 && (
      <div class="pch-algo__block">
        <h4 class="pch-algo__h">{t("pch.algoHyperparams")}</h4>
        <ul class="pch-algo__params">
          {hyperparams.map((h) => (
            <li>
              <code class="pch-algo__param-name">{h.name}</code>
              {h.default && <span class="pch-algo__default">default {h.default}</span>}
              <span class="pch-algo__param-effect">{h.effect}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {(useWhen.length > 0 || avoidWhen.length > 0) && (
      <div class="pch-algo__verdict">
        {useWhen.length > 0 && (
          <div class="pch-algo__col pch-algo__col--yes">
            <h4 class="pch-algo__h">{t("pch.algoReachFor")}</h4>
            <ul>
              {useWhen.map((u) => (
                <li>{u}</li>
              ))}
            </ul>
          </div>
        )}
        {avoidWhen.length > 0 && (
          <div class="pch-algo__col pch-algo__col--no">
            <h4 class="pch-algo__h">{t("pch.algoLookElsewhere")}</h4>
            <ul>
              {avoidWhen.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .pch-algo {
    position: relative;
    margin: 2rem 0;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    border-radius: 1.1rem;
    overflow: hidden;
    background:
      radial-gradient(
        120% 90% at 50% -20%,
        color-mix(in srgb, var(--pch-fn, #c599ff) 9%, transparent),
        transparent 55%
      ),
      var(--sl-color-bg-nav, transparent);
  }
  .pch-algo::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 3px;
    z-index: 2;
    background: linear-gradient(90deg, var(--pch-fn, #c599ff), var(--pch-blue, #4b8bbe));
  }

  .pch-algo .pch-viz__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .pch-algo__type {
    margin-inline-start: auto;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.02em;
  }

  .pch-algo__body {
    padding: 1rem 1.1rem 1.1rem;
    display: grid;
    gap: 1.05rem;
  }

  .pch-algo__api {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .pch-algo__api-label {
    font-family: "Fira Code", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 0.12rem 0.42rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--pch-blue, #4b8bbe) 18%, transparent);
    color: var(--pch-blue-bright, #6ba9dd);
  }

  .pch-algo__h {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .pch-algo__block ul {
    margin: 0;
    padding-inline-start: 1.15rem;
    display: grid;
    gap: 0.3rem;
    line-height: 1.55;
  }

  .pch-algo__cost {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pch-algo__cost > div {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 0.55rem;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    background: color-mix(in srgb, var(--pch-surface, #161b22) 26%, transparent);
  }
  .pch-algo__cost dt {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .pch-algo__cost dd {
    margin: 0;
  }
  .pch-algo__notation {
    margin: 0.45rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .pch-algo__params {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .pch-algo__params li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1.55;
  }
  .pch-algo__param-name {
    font-weight: 600;
  }
  .pch-algo__default {
    font-family: "Fira Code", monospace;
    font-size: 0.7rem;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    color: var(--sl-color-gray-3);
  }
  .pch-algo__param-effect {
    flex: 1 1 16rem;
  }

  .pch-algo__verdict {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 46rem) {
    .pch-algo__verdict {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pch-algo__col {
    padding: 0.7rem 0.85rem;
    border-radius: 0.7rem;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
  }
  .pch-algo__col--yes {
    border-color: color-mix(in srgb, var(--pch-string, #a5d6a4) 40%, transparent);
    background: color-mix(in srgb, var(--pch-string, #a5d6a4) 8%, transparent);
  }
  .pch-algo__col--no {
    border-color: color-mix(in srgb, #e86e6e 34%, transparent);
    background: color-mix(in srgb, #e86e6e 7%, transparent);
  }
  .pch-algo__col ul {
    margin: 0;
    padding-inline-start: 1.15rem;
    display: grid;
    gap: 0.3rem;
    line-height: 1.55;
  }
</style>

---
import fs from "node:fs/promises";
import { Code } from "astro:components";
import type { ShikiTransformer } from "shiki";

interface Props {
  file: string;
  lang?: string;
  title?: string;
  meta?: string;
  open?: boolean;
}
const { file, lang = "python", meta, title, open = true } = Astro.props;
const fileEtension = file.split(".").pop() ?? "python";
const code = (await fs.readFile(file, "utf-8")).replace(/\s+$/, "");

// `@astropub/md` used to push a fenced block back through the site markdown
// pipeline so rehype-pretty-code styled it. That package peers
// `@astrojs/markdown-remark@^3` and is unmaintained, so this renders through
// Astro's own Shiki `<Code>` instead and reproduces the exact attributes
// src/styles/global.css keys off: the `data-rehype-pretty-code-*` panel
// wrapper, and `[data-line]` spans for the CSS line-number counter.
const maxDigits = String(code.split("\n").length).length;
const prettyCodeShape: ShikiTransformer = {
  name: "pch-pretty-code-shape",
  code(node) {
    node.properties["data-language"] = lang;
    node.properties["data-line-numbers"] = "";
    node.properties["data-line-numbers-max-digits"] = String(maxDigits);
  },
  line(node) {
    node.properties["data-line"] = "";
  },
};

const t = Astro.locals.t;

const githubLink = `https://github.com/Ravikisha/PythonCentralHub/blob/main/${file}`;
---

<details class="pch-filecode" open={open}>
  <summary>
    <span class="pch-fc-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="pch-fc-name">{title ?? fileEtension}</span>
  </summary>
  <a
    class="pch-fc-gh"
    href={githubLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t("pch.viewOnGithub")}
  >
    <i class="fa-brands fa-github" aria-hidden="true"></i>
    <span>{t("pch.viewSource")}</span>
  </a>
  <figure data-rehype-pretty-code-figure>
    <figcaption data-rehype-pretty-code-title data-language={lang}>
      {title ?? fileEtension}
    </figcaption>
    <Code
      code={code}
      lang={lang as any}
      meta={meta}
      themes={{ light: "github-light", dark: "github-dark-dimmed" }}
      defaultColor={false}
      transformers={[prettyCodeShape]}
    />
  </figure>
</details>

<style>
  .pch-filecode {
    position: relative;
    margin: 1.25rem 0;
    border: 1px solid var(--pch-line);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--pch-ink, #0d1117);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .pch-filecode[open] {
    box-shadow: 0 16px 38px -26px color-mix(in srgb, var(--pch-blue, #4b8bbe) 55%, transparent);
  }
  .pch-filecode:hover {
    border-color: color-mix(in srgb, var(--pch-blue, #4b8bbe) 45%, transparent);
  }

  /* Terminal-style title bar as the disclosure trigger. */
  .pch-filecode > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    background: #10151c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-family: "Source Code Pro", monospace;
    font-size: 0.85rem;
    color: #d7dde5;
  }
  .pch-filecode > summary::-webkit-details-marker { display: none; }

  .pch-fc-dots { display: inline-flex; gap: 0.35rem; }
  .pch-fc-dots i {
    width: 10px; height: 10px; border-radius: 50%; display: inline-block;
  }
  .pch-fc-dots i:nth-child(1) { background: #ff5f57; }
  .pch-fc-dots i:nth-child(2) { background: #febc2e; }
  .pch-fc-dots i:nth-child(3) { background: #28c840; }

  .pch-fc-name { color: #d7dde5; }

  /* GitHub button — corner affordance, brand hover. */
  .pch-fc-gh {
    position: absolute;
    top: 0.42rem;
    inset-inline-end: 0.7rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid var(--pch-line);
    background: color-mix(in srgb, var(--pch-surface, #161b22) 70%, transparent);
    color: var(--pch-blue-bright, #6ba9dd);
    font-family: "Source Code Pro", monospace;
    font-size: 0.75rem;
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .pch-fc-gh:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--pch-blue, #4b8bbe) 60%, transparent);
    color: var(--pch-amber, #ffd343);
  }

  @media (prefers-reduced-motion: reduce) {
    .pch-filecode,
    .pch-fc-gh { transition: none; }
  }
</style>

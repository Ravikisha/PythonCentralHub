---
// Custom sidebar override: adds a search box + collapse/expand-all control
// above Starlight's default sidebar, then renders the default sidebar
// unchanged. Behaviour lives in /scripts/sidebar-enhance.js.
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/Sidebar.astro";
---

<div class="pch-sidebar-tools">
  <div class="pch-search-row">
    <i class="fas fa-search pch-search-icon" aria-hidden="true"></i>
    <input
      id="pch-sidebar-search"
      class="pch-sidebar-search"
      type="search"
      placeholder="Search menu…"
      aria-label="Search sidebar menu"
      autocomplete="off"
    />
  </div>
  <button
    id="pch-sidebar-toggle-all"
    class="pch-sidebar-toggle-all"
    type="button"
    aria-expanded="true"
  >
    <i class="fas fa-angles-up" aria-hidden="true"></i>
    <span class="pch-toggle-label">Collapse all</span>
  </button>
  <p id="pch-sidebar-noresults" class="pch-sidebar-noresults" hidden>
    No matching pages
  </p>
</div>

<Default {...Astro.props}><slot /></Default>

<script src="/scripts/sidebar-enhance.js"></script>

<style is:global>
  .pch-sidebar-tools {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .pch-search-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  .pch-search-icon {
    position: absolute;
    inset-inline-start: 0.6rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .pch-sidebar-search {
    width: 100%;
    padding: 0.45rem 0.6rem 0.45rem 1.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }

  .pch-sidebar-search:focus {
    outline: none;
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 0 0 1px var(--sl-color-text-accent);
  }

  .pch-sidebar-search::placeholder {
    color: var(--sl-color-gray-3);
  }

  .pch-sidebar-toggle-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }

  .pch-sidebar-toggle-all:hover,
  .pch-sidebar-toggle-all:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-text-accent);
  }

  .pch-sidebar-noresults {
    margin: 0;
    padding: 0.25rem 0.1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /* Search filtering: hidden sidebar entries. */
  .sidebar-content li.pch-hidden {
    display: none;
  }
</style>

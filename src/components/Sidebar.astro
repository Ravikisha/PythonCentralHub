---
// Custom sidebar override: adds a search box + collapse/expand-all control
// above Starlight's default sidebar, then renders the default sidebar
// unchanged. Behaviour lives in /scripts/sidebar-enhance.js.
import Default from "@astrojs/starlight/components/Sidebar.astro";

const t = Astro.locals.t;
---

<div class="pch-sidebar-tools">
  <div class="pch-search-row">
    <i class="fas fa-search pch-search-icon" aria-hidden="true"></i>
    <input
      id="pch-sidebar-search"
      class="pch-sidebar-search"
      type="search"
      placeholder={t("pch.sidebarSearchPlaceholder")}
      aria-label={t("pch.sidebarSearchLabel")}
      autocomplete="off"
    />
  </div>
  <button
    id="pch-sidebar-toggle-all"
    class="pch-sidebar-toggle-all"
    type="button"
    aria-expanded="true"
    data-label-collapse={t("pch.sidebarCollapseAll")}
    data-label-expand={t("pch.sidebarExpandAll")}
  >
    <i class="fas fa-angles-up" aria-hidden="true"></i>
    <span class="pch-toggle-label">{t("pch.sidebarCollapseAll")}</span>
  </button>
  <p id="pch-sidebar-noresults" class="pch-sidebar-noresults" hidden>
    {t("pch.sidebarNoResults")}
  </p>
</div>

<Default />

<script is:inline src="/scripts/sidebar-enhance.js"></script>

<script>
  /**
   * Paints completion state onto the sidebar: a tick beside every finished
   * page, and an "n/m" badge on every group.
   *
   * Counts come from the sidebar's own DOM rather than the build-time
   * manifest -- the group already lists exactly the pages it contains, so its
   * link count is the denominator, with no extra request and nothing to keep
   * in sync. Nested groups intentionally count their descendants.
   */
  import { pageIdOf } from "../lib/progress/ids";
  import { isComplete, subscribe, read } from "../lib/progress/local";

  const pane = document.querySelector<HTMLElement>(".sidebar-content");

  if (pane) {
    const paint = () => {
      const state = read();

      const done = new WeakSet<Element>();
      pane.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
        const id = pageIdOf(new URL(a.href, window.location.origin).pathname);
        if (!id) return;
        a.dataset.pchTracked = "true";
        if (isComplete(id, state)) {
          a.dataset.pchDone = "true";
          done.add(a);
        } else {
          delete a.dataset.pchDone;
        }
      });

      pane.querySelectorAll("details").forEach((group) => {
        const links = group.querySelectorAll<HTMLAnchorElement>("a[data-pch-tracked]");
        if (!links.length) return;

        const finished = Array.from(links).filter((a) => done.has(a)).length;
        const summary = group.querySelector("summary");
        if (!summary) return;

        let badge = summary.querySelector<HTMLElement>("[data-pch-count]");
        if (!badge) {
          badge = document.createElement("span");
          badge.dataset.pchCount = "";
          badge.className = "pch-sidebar-count";
          summary.appendChild(badge);
        }
        badge.textContent = `${finished}/${links.length}`;
        badge.dataset.complete = String(finished === links.length);
      });
    };

    paint();
    subscribe(paint);
  }
</script>

<style is:global>
  .pch-sidebar-tools {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .pch-search-row {
    position: relative;
    display: flex;
    align-items: center;
  }

  .pch-search-icon {
    position: absolute;
    inset-inline-start: 0.6rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .pch-sidebar-search {
    width: 100%;
    padding: 0.45rem 0.6rem 0.45rem 1.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }

  .pch-sidebar-search:focus {
    outline: none;
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 0 0 1px var(--sl-color-text-accent);
  }

  .pch-sidebar-search::placeholder {
    color: var(--sl-color-gray-3);
  }

  .pch-sidebar-toggle-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-xs);
    cursor: pointer;
  }

  .pch-sidebar-toggle-all:hover,
  .pch-sidebar-toggle-all:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-text-accent);
  }

  .pch-sidebar-noresults {
    margin: 0;
    padding: 0.25rem 0.1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /* Search filtering: hidden sidebar entries. */
  .sidebar-content li.pch-hidden {
    display: none;
  }
</style>

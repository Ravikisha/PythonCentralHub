---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/Head.astro";

const { entry } = Astro.props;
const data = entry?.data ?? ({} as Record<string, any>);

const siteUrl = Astro.site?.href?.replace(/\/$/, "") ?? "";
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const path = Astro.url.pathname;

// Map the content section to a schema.org type.
let articleType = "TechArticle";
if (path.includes("/tutorials/")) articleType = "TechArticle";
else if (path.includes("/projects/")) articleType = "HowTo";
else if (path.includes("/guides/")) articleType = "TechArticle";

const article = {
  "@context": "https://schema.org",
  "@type": articleType,
  headline: data.title ?? "Python Central Hub",
  description: data.description ?? "",
  url: pageUrl,
  inLanguage: "en",
  author: { "@type": "Person", name: "Ravi Kishan" },
  publisher: {
    "@type": "Organization",
    name: "Python Central Hub",
    url: siteUrl,
  },
};

// Build a BreadcrumbList from the URL path segments.
const segments = path.split("/").filter(Boolean);
let acc = "";
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: `${siteUrl}/`,
  },
  ...segments.map((seg, i) => {
    acc += `/${seg}`;
    const name = decodeURIComponent(seg)
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());
    return {
      "@type": "ListItem",
      position: i + 2,
      name,
      item: `${siteUrl}${acc}/`,
    };
  }),
];

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
---

<Default {...Astro.props}><slot /></Default>

<script type="application/ld+json" set:html={JSON.stringify(article)} is:inline />
{segments.length > 0 && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbs)}
    is:inline
  />
)}

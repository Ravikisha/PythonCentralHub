---
/**
 * The OAuth buttons shared by /login and /signup.
 *
 * GitHub can be hidden with `PUBLIC_AUTH_GITHUB=off` while its OAuth client
 * secret is still missing from the Firebase console -- without the secret the
 * provider returns `auth/operation-not-allowed`, and a button that always
 * fails is worse than no button. When it is shown and still unconfigured, the
 * error surfaces as "that sign-in method is not available yet".
 */
const t = Astro.locals.t;
const showGithub = import.meta.env.PUBLIC_AUTH_GITHUB !== "off";
---

<div class="pch-auth__providers">
  <button type="button" class="pch-auth__provider" data-pch-oauth="google">
    <i class="fab fa-google" aria-hidden="true"></i>
    {t("pch.authContinueGoogle")}
  </button>

  {
    showGithub && (
      <button type="button" class="pch-auth__provider" data-pch-oauth="github">
        <i class="fab fa-github" aria-hidden="true" />
        {t("pch.authContinueGithub")}
      </button>
    )
  }
</div>

<p class="pch-auth__divider">{t("pch.authOr")}</p>

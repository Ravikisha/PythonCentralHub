---
/**
 * Ships the translated auth error strings to the browser.
 *
 * Auth failures are reported by the Firebase SDK at runtime, so their messages
 * cannot be rendered server-side. Every auth page includes this component
 * once; it emits the whole `pch.authErr*` table as JSON, keyed exactly as
 * `authErrorKey()` in src/lib/firebase/auth.ts returns, and
 * src/lib/auth/messages.ts looks the text up from there.
 *
 * Keeping the `t()` calls in one place also keeps scripts/check-i18n.mjs
 * honest: it scans source for `t('pch.…')`, so a key that only ever appeared
 * inside a JS string would be reported as unused.
 */
const t = Astro.locals.t;

const messages: Record<string, string> = {
  "pch.authErrInvalidCredential": t("pch.authErrInvalidCredential"),
  "pch.authErrInvalidEmail": t("pch.authErrInvalidEmail"),
  "pch.authErrEmailInUse": t("pch.authErrEmailInUse"),
  "pch.authErrWeakPassword": t("pch.authErrWeakPassword"),
  "pch.authErrTooManyRequests": t("pch.authErrTooManyRequests"),
  "pch.authErrNetwork": t("pch.authErrNetwork"),
  "pch.authErrPopupClosed": t("pch.authErrPopupClosed"),
  "pch.authErrDifferentProvider": t("pch.authErrDifferentProvider"),
  "pch.authErrRecentLogin": t("pch.authErrRecentLogin"),
  "pch.authErrDisabled": t("pch.authErrDisabled"),
  "pch.authErrProviderDisabled": t("pch.authErrProviderDisabled"),
  "pch.authErrGeneric": t("pch.authErrGeneric"),
  "pch.authErrRequired": t("pch.authErrRequired"),
};
---

<script type="application/json" data-pch-auth-messages set:html={JSON.stringify(messages)} />

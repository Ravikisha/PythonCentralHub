---
// reCAPTCHA v3 site key (optional). Exposed to the client only when set.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;

const t = Astro.locals.t;
---

<div class="app">
  <h1>{t("pch.feedbackHeading")}</h1>
  <p>{t("pch.feedbackSubheading")}</p>

  <noscript>
    <p
      class="block mb-4 p-3 rounded-lg text-center text-sm bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200"
    >
      {t("pch.feedbackNoscript")}
    </p>
  </noscript>
  <form class="container" id="feedbackForm" data-recaptcha-key={recaptchaSiteKey ?? ""}>
    <div class="item">
      <label for="0" aria-label={t("pch.ratingVeryDissatisfied")}>
        <input class="radio" type="radio" name="feedback" id="0" value="1" />
        <span class="face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="9" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="15" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <path d="M8.5 16 Q12 13.8 15.5 16" />
            <path d="M8 8.6 L10.2 9.8" /><path d="M16 8.6 L13.8 9.8" />
          </svg>
        </span>
      </label>
    </div>

    <div class="item">
      <label for="1" aria-label={t("pch.ratingDissatisfied")}>
        <input class="radio" type="radio" name="feedback" id="1" value="2" />
        <span class="face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="9" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="15" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <path d="M8.5 16 Q12 14.4 15.5 16" />
          </svg>
        </span>
      </label>
    </div>

    <div class="item">
      <label for="2" aria-label={t("pch.ratingNeutral")}>
        <input class="radio" type="radio" name="feedback" id="2" value="3" />
        <span class="face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="9" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="15" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <path d="M8.5 15 L15.5 15" />
          </svg>
        </span>
      </label>
    </div>

    <div class="item">
      <label for="3" aria-label={t("pch.ratingSatisfied")}>
        <input class="radio" type="radio" name="feedback" id="3" value="4" />
        <span class="face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="9" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="15" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <path d="M8.5 14 Q12 16.6 15.5 14" />
          </svg>
        </span>
      </label>
    </div>

    <div class="item">
      <label for="4" aria-label={t("pch.ratingVerySatisfied")}>
        <input class="radio" type="radio" name="feedback" id="4" value="5" />
        <span class="face">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <circle cx="9" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <circle cx="15" cy="10.5" r="0.7" fill="currentColor" stroke="none" />
            <path d="M8 13.6 Q12 17.6 16 13.6" />
          </svg>
        </span>
      </label>
    </div>

    <div class="w-full flex flex-col mb-4 justify-start">
      <label
        for="email"
        class="block mb-2 text-start text-sm font-poppins font-bold text-gray-900 dark:text-white"
        >{t("pch.feedbackEmail")} <span class="text-red-500" aria-hidden="true">*</span></label
      >
      <input
        type="email"
        id="email"
        aria-required="true"
        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
        placeholder={t("pch.feedbackEmailPlaceholder")}
        required
        name="email"
      />
    </div>

    <div class="w-full flex flex-col mb-4 justify-start">
      <label
        for="comment"
        class="block mb-2 text-start text-sm font-poppins font-bold text-gray-900 dark:text-white"
        >{t("pch.feedbackComment")} <span class="text-red-500" aria-hidden="true">*</span></label
      >
      <textarea
        id="comment"
        aria-required="true"
        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
        placeholder={t("pch.feedbackCommentPlaceholder")}
        required
        name="comment"></textarea>
    </div>

    <div id="feedbackFormError" role="alert" aria-live="polite" class="sr-only"></div>

    <div class="flex justify-end w-full">
      <button
        id="feedbackSubmit"
        type="submit"
        class="inline-flex items-center justify-center gap-2 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span
          id="feedbackSpinner"
          class="hidden w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"
          aria-hidden="true"></span>
        <span id="feedbackSubmitText">{t("pch.feedbackSubmit")}</span>
      </button>
    </div>
  </form>
</div>

<style>
  .app {
    text-align: center;
    margin-top: 50px;
  }

  h1,
  p {
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }

  .app {
    width: 90%;
    max-width: 500px;
    margin: 0 auto;
  }
  .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .item {
    width: 90px;
    height: 90px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
  }
  /* Keep radios in the DOM & focusable (was display:none) so keyboard
     users can tab to them; visually hidden behind the emoji label. */
  .radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  /* Brand SVG faces: muted until pointed at, brand on hover, filled brand
     when selected. Icons use currentColor so a single color drives them. */
  .face {
    display: inline-flex;
  }
  .radio ~ span.face svg {
    width: 2.7rem;
    height: 2.7rem;
    color: var(--sl-color-gray-3, #8b949e);
    cursor: pointer;
    border-radius: 0.5rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .item:hover .radio ~ span.face svg {
    color: var(--pch-blue-bright, #6ba9dd);
    transform: translateY(-2px);
  }
  .radio:checked ~ span.face svg {
    color: var(--pch-blue, #4b8bbe);
    transform: scale(1.14);
  }
  /* Visible focus ring for keyboard users. */
  .radio:focus-visible ~ span.face svg {
    outline: 2px solid var(--pch-blue-bright, #6ba9dd);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .radio ~ span.face svg,
    .item:hover .radio ~ span.face svg,
    .radio:checked ~ span.face svg {
      transition: none;
    }
    .item:hover .radio ~ span.face svg {
      transform: none;
    }
  }

  @media screen and (max-width: 500px) {
    .item {
      width: 54px;
      height: 54px;
    }
    .radio ~ span.face svg {
      width: 2rem;
      height: 2rem;
    }
    .radio:checked ~ span.face svg {
      transform: scale(1.1);
    }
  }
</style>

{recaptchaSiteKey && (
  <script
    is:inline
    src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
    async
  />
)}

<script type="module">
  // This component renders inside the Footer override, i.e. on every page on
  // the site, so nothing here may be imported statically: a top-level import
  // of the Firebase client would put ~30 KB of firebase/app into the initial
  // module graph of all ~5900 built pages. Both uses below are dynamic, which
  // keeps that chunk out of the critical path entirely.
  //
  // Analytics still starts on every page, as it did before, just at idle.
  const startAnalytics = () =>
    import("../lib/firebase/client").then((m) => m.initAnalytics());

  if (typeof window.requestIdleCallback === "function") {
    window.requestIdleCallback(() => void startAnalytics(), { timeout: 4000 });
  } else {
    window.setTimeout(() => void startAnalytics(), 1500);
  }

  // @ts-ignore
  function uuidv4() {
    if (typeof crypto !== "undefined" && crypto.randomUUID) {
      return crypto.randomUUID();
    }
    // Fallback for very old browsers.
    return Date.now().toString(36) + Math.random().toString(36).slice(2);
  }

  // @ts-ignore
  const form = document.getElementById("feedbackForm");
  // @ts-ignore
  const submitBtn = document.getElementById("feedbackSubmit");
  // @ts-ignore
  const spinner = document.getElementById("feedbackSpinner");
  // @ts-ignore
  const submitText = document.getElementById("feedbackSubmitText");
  // @ts-ignore
  const errorRegion = document.getElementById("feedbackFormError");
  // @ts-ignore
  const recaptchaKey = form ? form.dataset.recaptchaKey : "";

  // @ts-ignore
  function notify(title, description, variant) {
    // @ts-ignore
    if (window.toast && typeof window.toast.show === "function") {
      // @ts-ignore
      window.toast.show({ title, description, variant });
    }
    if (errorRegion) {
      // @ts-ignore
      errorRegion.textContent = description || title;
    }
  }

  // @ts-ignore
  function setLoading(isLoading) {
    if (!submitBtn || !spinner || !submitText) return;
    // @ts-ignore
    submitBtn.disabled = isLoading;
    spinner.classList.toggle("hidden", !isLoading);
    // @ts-ignore
    submitText.textContent = isLoading ? "Submitting..." : "Submit";
  }

  // @ts-ignore
  async function getRecaptchaToken() {
    // @ts-ignore
    if (!recaptchaKey || !window.grecaptcha) return "";
    try {
      // @ts-ignore
      await new Promise((resolve) => window.grecaptcha.ready(resolve));
      // @ts-ignore
      return await window.grecaptcha.execute(recaptchaKey, { action: "feedback" });
    } catch {
      return "";
    }
  }

  // Save message to firebase
  // @ts-ignore
  async function saveMessage(feedback, email, comment, recaptchaToken) {
    const { doc, setDoc } = await import("firebase/firestore");
    const { getDb } = await import("../lib/firebase/client");
    const db = await getDb();
    await setDoc(doc(db, "feedback", uuidv4()), {
      feedback: feedback,
      email: email,
      comment: comment,
      recaptchaToken: recaptchaToken,
      createdAt: new Date().toISOString(),
    });
  }

  // Submit form
  // @ts-ignore
  async function submitForm(e) {
    e.preventDefault();
    if (errorRegion) errorRegion.textContent = "";

    // @ts-ignore
    const feedbackField = this.feedback;
    // @ts-ignore
    const feedback = feedbackField ? feedbackField.value : "";
    if (!feedback) {
      notify("Please rate us", "Select an emoji before submitting.", "error");
      return;
    }
    setLoading(true);

    try {
      // @ts-ignore
      const email = this.email.value;
      // @ts-ignore
      const comment = this.comment.value;
      const recaptchaToken = await getRecaptchaToken();

      await saveMessage(feedback, email, comment, recaptchaToken);

      notify(
        "Feedback received",
        "Thank you for your feedback. We will use it to improve our website.",
        "success"
      );
      // @ts-ignore
      if (form) form.reset();
    } catch (err) {
      console.error("[feedback] submit failed:", err);
      notify(
        "Something went wrong",
        "We couldn't submit your feedback. Please try again later.",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }

  // Listen for form submit
  // @ts-ignore
  if (form) form.addEventListener("submit", submitForm);
</script>

---
// reCAPTCHA v3 site key (optional). Exposed to the client only when set.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<div class="app">
  <h1>Was this page helpful?</h1>
  <p>Let us know how we did</p>

  <noscript>
    <p
      class="block mb-4 p-3 rounded-lg text-center text-sm bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200"
    >
      Submitting feedback requires JavaScript to be enabled.
    </p>
  </noscript>
  <form class="container" id="feedbackForm" data-recaptcha-key={recaptchaSiteKey ?? ""}>
    <div class="item">
      <label for="0">
        <input class="radio" type="radio" name="feedback" id="0" value="1" />
        <span>🤬</span>
      </label>
    </div>

    <div class="item">
      <label for="1">
        <input class="radio" type="radio" name="feedback" id="1" value="2" />
        <span>🙁</span>
      </label>
    </div>

    <div class="item">
      <label for="2">
        <input class="radio" type="radio" name="feedback" id="2" value="3" />
        <span>😶</span>
      </label>
    </div>

    <div class="item">
      <label for="3">
        <input class="radio" type="radio" name="feedback" id="3" value="4" />
        <span>😁</span>
      </label>
    </div>

    <div class="item">
      <label for="4">
        <input class="radio" type="radio" name="feedback" id="4" value="5" />
        <span>😍</span>
      </label>
    </div>

    <div class="w-full flex flex-col mb-4 justify-start">
      <label
        for="email"
        class="block mb-2 text-start text-sm font-poppins font-bold text-gray-900 dark:text-white"
        >Email <span class="text-red-500" aria-hidden="true">*</span></label
      >
      <input
        type="email"
        id="email"
        aria-required="true"
        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
        placeholder="you@example.com"
        required
        name="email"
      />
    </div>

    <div class="w-full flex flex-col mb-4 justify-start">
      <label
        for="comment"
        class="block mb-2 text-start text-sm font-poppins font-bold text-gray-900 dark:text-white"
        >Comment <span class="text-red-500" aria-hidden="true">*</span></label
      >
      <textarea
        id="comment"
        aria-required="true"
        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
        placeholder="Share your opinion about this page..."
        required
        name="comment"></textarea>
    </div>

    <div id="feedbackFormError" role="alert" aria-live="polite" class="sr-only"></div>

    <div class="flex justify-end w-full">
      <button
        id="feedbackSubmit"
        type="submit"
        class="inline-flex items-center justify-center gap-2 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span
          id="feedbackSpinner"
          class="hidden w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"
          aria-hidden="true"></span>
        <span id="feedbackSubmitText">Submit</span>
      </button>
    </div>
  </form>
</div>

<style>
  .app {
    text-align: center;
    margin-top: 50px;
  }

  h1,
  p {
    margin: 0;
    padding: 0;
    line-height: 1.5;
  }

  .app {
    width: 90%;
    max-width: 500px;
    margin: 0 auto;
  }
  .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .item {
    width: 90px;
    height: 90px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
  }
  /* Keep radios in the DOM & focusable (was display:none) so keyboard
     users can tab to them; visually hidden behind the emoji label. */
  .radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }
  .radio ~ span {
    font-size: 3rem;
    filter: grayscale(100);
    cursor: pointer;
    transition: 0.3s;
    border-radius: 0.5rem;
  }

  .radio:checked ~ span {
    filter: grayscale(0);
    font-size: 4rem;
  }

  /* Visible focus ring for keyboard users. */
  .radio:focus-visible ~ span {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 4px;
  }

  @media screen and (max-width: 500px) {
    .item {
      width: 50px;
      height: 50px;
    }
    .radio ~ span {
      font-size: 2rem;
    }
    .radio:checked ~ span {
      font-size: 3rem;
    }
  }
</style>

{recaptchaSiteKey && (
  <script
    is:inline
    src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}
    async
  />
)}

<script type="module">
  // @ts-ignore
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.2/firebase-app.js";
  // @ts-ignore
  import { getAnalytics } from "https://www.gstatic.com/firebasejs/10.7.2/firebase-analytics.js";
  // @ts-ignore
  import {getFirestore, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.7.2/firebase-firestore.js";
  // TODO: Add SDKs for Firebase products that you want to use
  // https://firebase.google.com/docs/web/setup#available-libraries

  // Your web app's Firebase configuration
  // For Firebase JS SDK v7.20.0 and later, measurementId is optional
  const firebaseConfig = {
    apiKey: "AIzaSyC9JRAi_fsezHf8PN-8A4tSoZYJmThEiAk",
    authDomain: "pythoncentralhub.firebaseapp.com",
    projectId: "pythoncentralhub",
    storageBucket: "pythoncentralhub.appspot.com",
    messagingSenderId: "479368830014",
    appId: "1:479368830014:web:87a5f98745df11c788056f",
    measurementId: "G-58ZCKY0YPD",
  };

  // Initialize Firebase
  const app = initializeApp(firebaseConfig);
  const analytics = getAnalytics(app);

  const db = getFirestore(app);

  // @ts-ignore
  function uuidv4() {
    if (typeof crypto !== "undefined" && crypto.randomUUID) {
      return crypto.randomUUID();
    }
    // Fallback for very old browsers.
    return Date.now().toString(36) + Math.random().toString(36).slice(2);
  }

  // @ts-ignore
  const form = document.getElementById("feedbackForm");
  // @ts-ignore
  const submitBtn = document.getElementById("feedbackSubmit");
  // @ts-ignore
  const spinner = document.getElementById("feedbackSpinner");
  // @ts-ignore
  const submitText = document.getElementById("feedbackSubmitText");
  // @ts-ignore
  const errorRegion = document.getElementById("feedbackFormError");
  // @ts-ignore
  const recaptchaKey = form ? form.dataset.recaptchaKey : "";

  // @ts-ignore
  function notify(title, description, variant) {
    // @ts-ignore
    if (window.toast && typeof window.toast.show === "function") {
      // @ts-ignore
      window.toast.show({ title, description, variant });
    }
    if (errorRegion) {
      // @ts-ignore
      errorRegion.textContent = description || title;
    }
  }

  // @ts-ignore
  function setLoading(isLoading) {
    if (!submitBtn || !spinner || !submitText) return;
    // @ts-ignore
    submitBtn.disabled = isLoading;
    spinner.classList.toggle("hidden", !isLoading);
    // @ts-ignore
    submitText.textContent = isLoading ? "Submitting..." : "Submit";
  }

  // @ts-ignore
  async function getRecaptchaToken() {
    // @ts-ignore
    if (!recaptchaKey || !window.grecaptcha) return "";
    try {
      // @ts-ignore
      await new Promise((resolve) => window.grecaptcha.ready(resolve));
      // @ts-ignore
      return await window.grecaptcha.execute(recaptchaKey, { action: "feedback" });
    } catch {
      return "";
    }
  }

  // Save message to firebase
  // @ts-ignore
  async function saveMessage(feedback, email, comment, recaptchaToken) {
    await setDoc(doc(db, "feedback", uuidv4()), {
      feedback: feedback,
      email: email,
      comment: comment,
      recaptchaToken: recaptchaToken,
      createdAt: new Date().toISOString(),
    });
  }

  // Submit form
  // @ts-ignore
  async function submitForm(e) {
    e.preventDefault();
    if (errorRegion) errorRegion.textContent = "";

    // @ts-ignore
    const feedbackField = this.feedback;
    // @ts-ignore
    const feedback = feedbackField ? feedbackField.value : "";
    if (!feedback) {
      notify("Please rate us", "Select an emoji before submitting.", "error");
      return;
    }
    setLoading(true);

    try {
      // @ts-ignore
      const email = this.email.value;
      // @ts-ignore
      const comment = this.comment.value;
      const recaptchaToken = await getRecaptchaToken();

      await saveMessage(feedback, email, comment, recaptchaToken);

      notify(
        "Feedback received",
        "Thank you for your feedback. We will use it to improve our website.",
        "success"
      );
      // @ts-ignore
      if (form) form.reset();
    } catch (err) {
      console.error("[feedback] submit failed:", err);
      notify(
        "Something went wrong",
        "We couldn't submit your feedback. Please try again later.",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }

  // Listen for form submit
  // @ts-ignore
  if (form) form.addEventListener("submit", submitForm);
</script>

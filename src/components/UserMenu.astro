---
/**
 * UserMenu — the account control in the site header.
 *
 * Renders on every page, so it is deliberately cheap:
 *
 *  - The markup ships both states (a "Sign in" link and an account button)
 *    and the script reveals one. Server-rendered HTML is static, so neither
 *    can be chosen at build time.
 *  - The choice is made synchronously from the localStorage hint written by
 *    src/lib/auth/hint.ts. No Firebase, no network, no layout shift for the
 *    common case.
 *  - The Firebase Auth SDK is fetched only when there is a hint to verify, or
 *    when the reader actually clicks "Sign out". A signed-out visitor never
 *    downloads it.
 *
 * Vanilla JS on purpose: a React island here would pull react-dom onto all
 * ~1190 pages for a dropdown.
 */
const t = Astro.locals.t;
---

<div class="pch-user" data-pch-user>
  <a class="pch-user__signin" href="/login" data-pch-signin>
    <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
    <span>{t("pch.authSignIn")}</span>
  </a>

  <div class="pch-user__account" data-pch-account hidden>
    <button
      type="button"
      class="pch-user__trigger"
      data-pch-trigger
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label={t("pch.authAccount")}
    >
      <img class="pch-user__avatar" alt="" data-pch-avatar hidden />
      <span class="pch-user__initial" data-pch-initial aria-hidden="true"></span>
    </button>

    <div class="pch-user__menu" role="menu" data-pch-menu hidden>
      <p class="pch-user__who">
        <span class="pch-user__name" data-pch-name></span>
        <span class="pch-user__email" data-pch-email></span>
      </p>
      <a role="menuitem" href="/dashboard"
        ><i class="fas fa-chart-line" aria-hidden="true"></i>{t("pch.authDashboard")}</a
      >
      <a role="menuitem" href="/certificates"
        ><i class="fas fa-award" aria-hidden="true"></i>{t("pch.authCertificates")}</a
      >
      <a role="menuitem" href="/leaderboard"
        ><i class="fas fa-ranking-star" aria-hidden="true"></i>{t("pch.boardTitle")}</a
      >
      <a role="menuitem" href="/profile"
        ><i class="fas fa-user" aria-hidden="true"></i>{t("pch.authProfile")}</a
      >
      <button type="button" role="menuitem" data-pch-signout>
        <i class="fas fa-right-from-bracket" aria-hidden="true"></i>{t("pch.authSignOut")}
      </button>
    </div>
  </div>
</div>

<script>
  import { readHint, initialOf, clearHint } from "../lib/auth/hint";

  const root = document.querySelector<HTMLElement>("[data-pch-user]");
  if (root) {
    const signin = root.querySelector<HTMLElement>("[data-pch-signin]")!;
    const account = root.querySelector<HTMLElement>("[data-pch-account]")!;
    const trigger = root.querySelector<HTMLButtonElement>("[data-pch-trigger]")!;
    const menu = root.querySelector<HTMLElement>("[data-pch-menu]")!;
    const avatar = root.querySelector<HTMLImageElement>("[data-pch-avatar]")!;
    const initial = root.querySelector<HTMLElement>("[data-pch-initial]")!;
    const nameEl = root.querySelector<HTMLElement>("[data-pch-name]")!;
    const emailEl = root.querySelector<HTMLElement>("[data-pch-email]")!;
    const signout = root.querySelector<HTMLButtonElement>("[data-pch-signout]")!;

    /**
     * Paint the two states. Anonymous sessions are treated as signed out:
     * they exist to hold progress, not to be an account.
     */
    function paint(hint: ReturnType<typeof readHint>) {
      const real = hint && !hint.anon;
      signin.hidden = !!real;
      account.hidden = !real;
      if (!real || !hint) return;

      nameEl.textContent = hint.name || hint.email;
      emailEl.textContent = hint.name ? hint.email : "";
      if (hint.photo) {
        avatar.src = hint.photo;
        avatar.hidden = false;
        initial.hidden = true;
      } else {
        avatar.hidden = true;
        initial.hidden = false;
        initial.textContent = initialOf(hint);
      }
    }

    paint(readHint());

    /* ---- dropdown ---- */
    const close = () => {
      menu.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = menu.hidden;
      menu.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", (e) => {
      if (!menu.hidden && !root.contains(e.target as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    /* ---- sign out ---- */
    signout.addEventListener("click", async () => {
      signout.disabled = true;
      try {
        const { signOutUser } = await import("../lib/firebase/auth");
        await signOutUser();
      } catch {
        clearHint(); // network died mid-sign-out; at least drop the local state
      }
      window.location.href = "/";
    });

    /**
     * Verify the hint against the real session, but only when there is one to
     * verify and only once the page is idle. This is what catches a session
     * that expired or was revoked on another device: the SDK corrects or
     * clears the hint and the menu repaints.
     */
    if (readHint()) {
      const verify = async () => {
        try {
          const { onUser } = await import("../lib/firebase/auth");
          await onUser(() => paint(readHint())); // onUser refreshes the hint itself
        } catch {
          /* offline: keep showing the cached identity */
        }
      };
      if (typeof window.requestIdleCallback === "function") {
        window.requestIdleCallback(() => void verify(), { timeout: 5000 });
      } else {
        window.setTimeout(() => void verify(), 2000);
      }
    }
  }
</script>

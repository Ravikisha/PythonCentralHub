---
/**
 * MathDrillDeck — spaced-repetition drilling over the Mathematics for Machine
 * Learning Recall cards.
 *
 * The deck is generated from the pages (scripts/gen-mml-recall.mjs, run via
 * `npm run mml:recall`), so a prompt cannot drift from the page that taught it.
 *
 * WHY A WRAPPER RATHER THAN IMPORTING THE DATA IN THE ISLAND
 * ---------------------------------------------------------
 * Same reason as `dsa/DrillDeck.astro`: the whole deck is a lot of prose to ship
 * to the browser. Resolving the filter here means a chapter overview embedding
 * one chapter's deck ships one chapter's prompts, not twelve.
 *
 * The React island itself is the DSA one, reused. Its props are generic — it
 * filters on `phase`, which `buildDeck` populates with the chapter directory
 * name — and it takes `groupNoun` / `groupLabels` so the filter control says
 * "Every chapter" over a list of chapters. The labels are computed here rather
 * than passed as a formatter: Astro serialises island props to JSON, so a
 * function prop would fail at hydration.
 *
 * Review history is shared with the DSA deck (one `pch:dsa:drill:v1` store).
 * That is intended: card keys are page-slug derived and therefore disjoint, so
 * one review history for the whole site is a feature, not a collision.
 *
 * Usage:
 *
 *   import MathDrillDeck from "../../../components/MathDrillDeck.astro";
 *
 *   <MathDrillDeck />
 *   <MathDrillDeck chapters={["Chapter 07 - Continuous Optimization"]} />
 */
import Deck from "./dsa/DrillDeck.tsx";
import { buildDeck, recallChapters, chapterLabel } from "../data/mml";

interface Props {
  /** Restrict to these chapter directory names. Omit for the whole module. */
  chapters?: string[];
}

const { chapters } = Astro.props as Props;

const items = buildDeck({ chapters }).map((i) => ({
  key: i.key,
  kind: i.kind,
  label: i.label,
  text: i.text,
  cardId: i.cardId,
  cardTitle: i.cardTitle,
  phase: i.phase,
  url: i.url,
}));

// Only offer a chapter in the filter if the current selection actually has cards
// from it — otherwise the reader can pick a chapter and get an empty deck.
const present = [...new Set(items.map((i) => i.phase))].sort();
const options = chapters?.length ? present : recallChapters.filter((c) => present.includes(c));

const groupLabels = Object.fromEntries(options.map((c) => [c, chapterLabel(c)]));
---

{
  items.length === 0 ? (
    <p>
      <em>
        No recall prompts matched. Re-run <code>npm run mml:recall</code> after adding a{" "}
        <code>## Recall card</code> section to a page.
      </em>
    </p>
  ) : (
    <Deck
      client:visible
      items={items}
      phases={options}
      groupNoun="chapter"
      groupLabels={groupLabels}
    />
  )
}

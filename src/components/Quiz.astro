---
/**
 * Quiz — self-check multiple choice for tutorial pages.
 *
 * Replaces the old "Mini-checkpoint" pattern, which printed the answer in
 * parentheses directly below the question. Here the answer stays hidden until
 * the reader commits to an option, then the explanation is revealed.
 *
 * Vanilla JS + progressive enhancement: with JS disabled the questions and
 * options still render, and a <details> holds the answer key.
 *
 * Usage in MDX:
 *
 * <Quiz
 *   questions={[
 *     {
 *       q: "Which loss does Logistic Regression minimize?",
 *       options: ["MSE", "Log loss", "Hinge loss", "MAE"],
 *       answer: 1,
 *       explain: "Log loss is convex for this model, so gradient descent finds the global minimum.",
 *     },
 *   ]}
 * />
 */
export interface QuizQuestion {
  /** The question text. Plain text — keep it one sentence. */
  q: string;
  /** 2-5 answer options, plain text. */
  options: string[];
  /** Zero-based index of the correct option. */
  answer: number;
  /** Shown after the reader answers, whether right or wrong. */
  explain?: string;
}

export interface Props {
  questions: QuizQuestion[];
  /** Heading shown in the panel bar. */
  title?: string;
}

const t = Astro.locals.t;

const { questions, title = t("pch.quizDefaultTitle") } = Astro.props;

const quizId = `quiz-${Math.random().toString(36).slice(2)}`;
---

<section class="pch-quiz" id={quizId} aria-label={title}>
  <div class="pch-viz__bar">
    <span class="pch-viz__tag">{t("pch.quizTag")}</span>
    <span class="pch-viz__title">{title}</span>
    <span class="pch-quiz__score" data-quiz-score aria-live="polite"></span>
  </div>

  <ol class="pch-quiz__list">
    {questions.map((item, qi) => (
      <li class="pch-quiz__item" data-quiz-item data-answer={item.answer}>
        <p class="pch-quiz__q">{item.q}</p>

        <div class="pch-quiz__options" role="group">
          {item.options.map((opt, oi) => (
            <button
              type="button"
              class="pch-quiz__opt"
              data-quiz-opt
              data-index={oi}
              data-correct={oi === item.answer ? "true" : "false"}
            >
              <span class="pch-quiz__letter">{String.fromCharCode(65 + oi)}</span>
              <span class="pch-quiz__text">{opt}</span>
            </button>
          ))}
        </div>

        {item.explain && (
          <p class="pch-quiz__explain" data-quiz-explain hidden>
            {item.explain}
          </p>
        )}

        {/* No-JS fallback: the answer key stays available behind a disclosure. */}
        <details class="pch-quiz__fallback">
          <summary>{t("pch.quizShowAnswer")}</summary>
          <p>
            <strong>{String.fromCharCode(65 + item.answer)}</strong> — {item.options[item.answer]}
            {item.explain ? ` — ${item.explain}` : ""}
          </p>
        </details>
      </li>
    ))}
  </ol>
</section>

<script define:vars={{ quizId }}>
  (function () {
    const root = document.getElementById(quizId);
    if (!root) return;

    // JS is available, so hide the <details> answer-key fallback.
    root.classList.add("pch-quiz--interactive");

    const items = Array.from(root.querySelectorAll("[data-quiz-item]"));
    const scoreEl = root.querySelector("[data-quiz-score]");
    let answered = 0;
    let correct = 0;

    function paintScore() {
      if (!scoreEl) return;
      scoreEl.textContent = `${correct} / ${items.length}`;
      scoreEl.dataset.state =
        answered < items.length ? "partial" : correct === items.length ? "perfect" : "done";
    }

    items.forEach((item) => {
      const opts = Array.from(item.querySelectorAll("[data-quiz-opt]"));
      const explain = item.querySelector("[data-quiz-explain]");

      opts.forEach((btn) => {
        btn.addEventListener("click", function () {
          if (item.dataset.done === "true") return;
          item.dataset.done = "true";
          answered += 1;

          const isRight = btn.dataset.correct === "true";
          if (isRight) correct += 1;

          opts.forEach((other) => {
            other.disabled = true;
            if (other.dataset.correct === "true") other.dataset.state = "correct";
          });
          btn.dataset.state = isRight ? "correct" : "wrong";

          if (explain) explain.hidden = false;
          paintScore();
        });
      });
    });

    paintScore();
  })();
</script>

<style>
  .pch-quiz {
    position: relative;
    margin: 2rem 0;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    border-radius: 1.1rem;
    overflow: hidden;
    background:
      radial-gradient(
        120% 90% at 50% -20%,
        color-mix(in srgb, var(--pch-string, #a5d6a4) 9%, transparent),
        transparent 55%
      ),
      var(--sl-color-bg-nav, transparent);
  }
  .pch-quiz::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 3px;
    z-index: 2;
    background: linear-gradient(90deg, var(--pch-string, #a5d6a4), var(--pch-blue, #4b8bbe));
  }

  .pch-quiz .pch-viz__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .pch-quiz__score {
    margin-inline-start: auto;
    font-family: "Fira Code", monospace;
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    color: var(--sl-color-gray-3);
  }
  .pch-quiz__score[data-state="perfect"] {
    color: var(--pch-string, #a5d6a4);
    border-color: color-mix(in srgb, var(--pch-string, #a5d6a4) 45%, transparent);
  }

  .pch-quiz__list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 1rem 1rem;
    counter-reset: pchq;
  }
  .pch-quiz__item {
    counter-increment: pchq;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--pch-line, rgba(139, 148, 158, 0.22));
  }
  .pch-quiz__item:last-child {
    border-bottom: none;
    padding-bottom: 0.25rem;
  }

  .pch-quiz__q {
    margin: 0 0 0.7rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .pch-quiz__q::before {
    content: "Q" counter(pchq) ". ";
    font-family: "Fira Code", monospace;
    color: var(--pch-blue-bright, #6ba9dd);
  }

  .pch-quiz__options {
    display: grid;
    gap: 0.45rem;
  }

  .pch-quiz__opt {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    width: 100%;
    text-align: start;
    padding: 0.55rem 0.7rem;
    border-radius: 0.6rem;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    background: color-mix(in srgb, var(--pch-surface, #161b22) 26%, transparent);
    color: inherit;
    font: inherit;
    line-height: 1.45;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .pch-quiz__opt:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--pch-blue, #4b8bbe) 55%, transparent);
    background: color-mix(in srgb, var(--pch-blue, #4b8bbe) 10%, transparent);
    transform: translateX(2px);
  }
  .pch-quiz__opt:disabled {
    cursor: default;
    opacity: 0.75;
  }
  .pch-quiz__opt[data-state="correct"] {
    opacity: 1;
    border-color: color-mix(in srgb, var(--pch-string, #a5d6a4) 65%, transparent);
    background: color-mix(in srgb, var(--pch-string, #a5d6a4) 14%, transparent);
  }
  .pch-quiz__opt[data-state="wrong"] {
    opacity: 1;
    border-color: color-mix(in srgb, #e86e6e 60%, transparent);
    background: color-mix(in srgb, #e86e6e 12%, transparent);
  }

  .pch-quiz__letter {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 0.4rem;
    font-family: "Fira Code", monospace;
    font-size: 0.78rem;
    background: color-mix(in srgb, var(--pch-blue, #4b8bbe) 18%, transparent);
    color: var(--pch-blue-bright, #6ba9dd);
  }
  .pch-quiz__opt[data-state="correct"] .pch-quiz__letter {
    background: color-mix(in srgb, var(--pch-string, #a5d6a4) 26%, transparent);
    color: var(--pch-string, #a5d6a4);
  }
  .pch-quiz__opt[data-state="wrong"] .pch-quiz__letter {
    background: color-mix(in srgb, #e86e6e 24%, transparent);
    color: #e86e6e;
  }

  .pch-quiz__explain {
    margin: 0.7rem 0 0;
    padding: 0.6rem 0.75rem;
    border-inline-start: 3px solid var(--pch-amber, #ffd343);
    border-radius: 0 0.5rem 0.5rem 0;
    background: color-mix(in srgb, var(--pch-amber, #ffd343) 9%, transparent);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  /* The disclosure exists only for the no-JS path. */
  .pch-quiz--interactive .pch-quiz__fallback {
    display: none;
  }
  .pch-quiz__fallback {
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pch-quiz__opt {
      transition: none;
    }
    .pch-quiz__opt:hover:not(:disabled) {
      transform: none;
    }
  }
</style>

---
/**
 * Figure — a committed, theme-aware static plot.
 *
 * p5 sketches carry intuition and mermaid carries structure, but neither can
 * show a real matplotlib result (an ROC curve on actual data, a learning curve,
 * a dendrogram). Those are generated at author time by `npm run figures` and
 * committed as an SVG pair under `public/images/ml/<slug>/`, then embedded here.
 *
 * Pass `src` without the `-dark.svg` / `-light.svg` suffix and both variants are
 * wired up; the browser swaps them with the site theme. Pass `single` for a
 * figure that reads correctly on either background.
 *
 * Usage in MDX:
 *
 * <Figure
 *   src="/images/ml/phase-03-regression/gradient-descent-paths"
 *   title="Gradient descent paths at three learning rates"
 *   alt="Contour plot with three descent trajectories..."
 *   caption="Too small and it crawls; too large and it diverges."
 * />
 */
export interface Props {
  /**
   * Path under `public/`, WITHOUT extension and without the theme suffix —
   * e.g. `/images/ml/phase-03-regression/learning-curves`.
   * With `single`, pass the full path including extension.
   */
  src: string;
  /** Accessible description of what the plot shows. Required — these are data. */
  alt: string;
  /** Shown in the panel header bar. */
  title?: string;
  /** Shown under the plot: what the reader should take away. */
  caption?: string;
  /** Set when one image works on both themes (pass a full path with extension). */
  single?: boolean;
  /** Intrinsic width/height, used to reserve layout space and avoid CLS. */
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  title,
  caption,
  single = false,
  width = 900,
  height = 540,
} = Astro.props;

const darkSrc = single ? src : `${src}-dark.svg`;
const lightSrc = single ? src : `${src}-light.svg`;
---

<figure class="pch-figure">
  <div class="pch-viz__bar">
    <span class="pch-viz__tag">figure</span>
    <span class="pch-viz__title">{title ?? alt}</span>
    <span class="pch-figure__lib">matplotlib</span>
  </div>

  <div class="pch-figure__stage">
    <img
      class="pch-figure__img pch-figure__img--dark"
      src={darkSrc}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
    {!single && (
      <img
        class="pch-figure__img pch-figure__img--light"
        src={lightSrc}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  {caption && <figcaption class="pch-figure__caption">{caption}</figcaption>}
</figure>

<!-- `is:global` is load-bearing: the light `<img>` is emitted from a `{...}`
     expression and did not receive this component's scoping class, so scoped
     rules skipped it entirely and both variants rendered, stacked. Every
     selector below is `pch-figure`-prefixed, so going global costs nothing. -->
<style is:global>
  .pch-figure {
    position: relative;
    margin: 2rem 0;
    border: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    border-radius: 1.1rem;
    overflow: hidden;
    background: var(--sl-color-bg-nav, transparent);
  }
  .pch-figure::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 3px;
    z-index: 2;
    background: linear-gradient(90deg, var(--pch-blue, #4b8bbe), var(--pch-string, #a5d6a4));
  }

  .pch-figure .pch-viz__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .pch-figure__lib {
    margin-inline-start: auto;
    font-family: "Fira Code", monospace;
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .pch-figure__stage {
    padding: 0.9rem;
    overflow-x: auto;
  }
  .pch-figure__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    min-width: 20rem;
  }

  /* Theme swap. Starlight stamps data-theme on :root; default to the dark
     variant so a missing attribute still renders something sensible.
     Each selector needs the `.pch-figure__stage img` prefix: Starlight's own
     `.content :is(img, …) { display: block }` is more specific than a lone
     class, so a single-class rule here loses and BOTH variants render. */
  .pch-figure__stage img.pch-figure__img--light {
    display: none;
  }
  :root[data-theme="light"] .pch-figure__stage img.pch-figure__img--dark {
    display: none;
  }
  :root[data-theme="light"] .pch-figure__stage img.pch-figure__img--light {
    display: block;
  }

  .pch-figure__caption {
    margin: 0;
    padding: 0.65rem 0.95rem 0.85rem;
    border-top: 1px solid var(--pch-line, rgba(139, 148, 158, 0.22));
    background: color-mix(in srgb, var(--pch-surface, #161b22) 22%, transparent);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
</style>

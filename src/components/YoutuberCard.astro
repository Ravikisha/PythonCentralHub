---
const {coverImg, profileImg, name, channelLink} = Astro.props;
---

<style>
  .yt-card {
    position: relative;
    max-width: 700px;
    width: 100%;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--pch-line);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--pch-surface) 60%, transparent), transparent 55%),
      var(--sl-color-bg-nav, transparent);
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    color: var(--sl-color-text);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Brand top rail — mirrors the site's <Card> treatment. */
  .yt-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--pch-blue), var(--pch-amber));
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 2;
  }

  .yt-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--pch-blue) 50%, transparent);
    box-shadow: 0 24px 50px -26px color-mix(in srgb, var(--pch-blue) 55%, transparent);
  }
  .yt-card:hover::before { opacity: 1; }

  .yt-card-image img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
  }

  .yt-profile-image img {
    z-index: 1;
    width: 120px;
    height: 120px;
    position: relative;
    margin: -75px auto 0;
    display: block;
    border-radius: 100px;
    border: 6px solid var(--sl-color-bg-nav, var(--pch-surface));
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s ease;
  }
  .yt-card:hover .yt-profile-image img { transform: scale(1.06); }

  .yt-card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .yt-card-content h3 {
    font-family: "Atkinson Hyperlegible", sans-serif;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--sl-color-white);
    font-weight: 700;
    margin-top: -8px;
  }

  /* Prompt-marked handle, tying the card to the site's REPL motif. */
  .yt-card-content h3::before {
    content: ">>> ";
    font-family: "Source Code Pro", monospace;
    font-size: 0.85rem;
    color: var(--pch-amber);
    vertical-align: middle;
  }

  .yt-subscribe {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #c4302b; /* YouTube brand red — intentional, not a token */
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    border: none;
    outline: none;
    padding: 0.6rem 1.3rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    margin-top: 14px;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .yt-subscribe svg { width: 1.2em; height: 1.2em; }
  .yt-subscribe:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -10px rgba(196, 48, 43, 0.65);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-card,
    .yt-card::before,
    .yt-profile-image img,
    .yt-subscribe { transition: none; }
  }
</style>

<div class="yt-card">
  <div class="yt-card-image">
    <img src=`${coverImg}` alt={`${name} channel cover image`} />
  </div>
  <div class="yt-profile-image">
    <img src=`${profileImg}` alt={`${name} profile picture`} />
  </div>
  <div class="yt-card-content">
    <h3>{name}</h3>
    <a class="yt-subscribe"
      target="_blank"
      rel="noopener noreferrer"
      href=`${channelLink}`>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
      Subscribe
    </a>
  </div>
</div>

---
/**
 * CompanyBoard — one company's interview profile plus its reported problem set.
 *
 * Two halves, deliberately weighted differently:
 *
 *   * **Round structure and the bar** — companies publish these and recruiters
 *     confirm them, so they are presented as fact.
 *   * **Problem tags** — crowd-reported, stale, and biased toward whoever posted.
 *     They are labelled "reported", never "asked", and the page says so in
 *     plain language rather than burying the caveat.
 *
 * The genuinely durable signal is `patterns`: which pattern *families* a company
 * leans on changes far more slowly than which individual problems it uses. That
 * is why the pattern list is shown above the problem list, not below it.
 *
 * Usage:
 *
 *   import CompanyBoard from "../../../../components/dsa/CompanyBoard.astro";
 *
 *   <CompanyBoard company="google" />
 */
import { getCompany, problemsForCompany, problemsForPatterns, problemUrl, getSheet } from "../../data/dsa";
import ProblemTable, { type Row } from "./ProblemTable";

interface Props {
  /** Company slug from companies.yaml. */
  company: string;
}

const { company: slug } = Astro.props;
const company = getCompany(slug);

/**
 * Prefer explicitly tagged problems. Where a company has few or no tags yet,
 * fall back to its pattern families — a pattern-derived list is more honest than
 * an empty table, and is arguably the better preparation anyway.
 */
const tagged = company ? problemsForCompany(slug) : [];
const derived = company ? problemsForPatterns(company.patterns) : [];
const usingDerived = tagged.length < 12;
const shown = usingDerived ? derived : tagged;

const sheetName = (key: string): string => getSheet(key)?.name ?? key;

const rows: Row[] = shown.map((p) => ({
  lc: p.lc,
  slug: p.slug,
  title: p.title,
  difficulty: p.difficulty,
  premium: p.premium,
  url: problemUrl(p),
  sheets: Object.keys(p.sheets ?? {}).map(sheetName),
  freq: p.freq,
}));
---

{
  !company ? (
    <aside class="pch-pl__missing">
      <strong>Unknown company</strong> <code>{slug}</code>. Profiles are defined in
      {" "}
      <code>src/data/dsa/companies.yaml</code>.
    </aside>
  ) : (
    <div class="pch-co">
      <p class="pch-co__blurb">{company.blurb}</p>

      <h3>The loop</h3>
      <div class="pch-co__rounds">
        {company.rounds.map((r) => (
          <div class="pch-co__round">
            <span class="pch-co__roundname">{r.name}</span>
            <span class="pch-co__roundmeta">
              {r.count}× · {r.minutes} min
            </span>
            <span class="pch-co__roundfocus">{r.focus}</span>
          </div>
        ))}
      </div>

      <h3>The bar</h3>
      <p class="pch-co__bar">{company.bar}</p>

      <h3>What they lean on</h3>
      <p class="pch-co__patternnote">
        This is the durable part. Which <em>pattern families</em> a company
        favours is far more stable than which individual problems it uses, so
        prepare in this order:
      </p>
      <ol class="pch-co__patterns">
        {company.patterns.map((p) => (
          <li>
            <code>{p}</code>
          </li>
        ))}
      </ol>

      <h3>Quirks worth knowing</h3>
      <ul class="pch-co__quirks">
        {company.quirks.map((q) => (
          <li>{q}</li>
        ))}
      </ul>

      <h3>Reported problems</h3>
      <aside class="pch-co__caveat">
        <strong>Read this before you trust the list.</strong> No company
        publishes its question bank. Every "asked at {company.name}" list in
        circulation — including this one — is aggregated from candidate reports,
        is months to years out of date, and over-represents whoever bothered to
        post. Use it to choose an <em>order</em> to practise in. Do not use it as
        a question bank, and do not assume a problem missing from it is safe to
        skip.
        {usingDerived ? (
          <>
            {" "}
            The list below is currently derived from {company.name}'s pattern
            families rather than from per-problem tags, which is the more honest
            basis while the tag data is thin.
          </>
        ) : null}
      </aside>

      <ProblemTable client:visible groups={[{ rows }]} />
    </div>
  )
}

---
/**
 * StudyPlanner — a week-by-week plan derived from the syllabus and the problem database.
 *
 * WHY THIS IS GENERATED RATHER THAN WRITTEN
 * -----------------------------------------
 * The Phase-19 roadmap page carries a hand-written 8-week table, and that is the right
 * shape for prose: it names themes and sets expectations. What it cannot do is stay in
 * step with 104 pattern pages and 444 problems, or answer "what if I have 5 weeks, not
 * 8?" or "what if I am only interviewing at ByteDance?".
 *
 * So this builds the plan from `syllabus.yaml` (teaching order, generated from the
 * filesystem) and `problems.yaml`. Weeks are balanced by **problem count**, not page
 * count, because a 17-problem page is not a 3-problem page's worth of work.
 *
 * TWO THINGS IT DELIBERATELY SHOWS RATHER THAN HIDES
 * --------------------------------------------------
 *   1. **What it defers.** The full syllabus is well over a year at 10 h/week; the exact
 *      figure is computed for whatever budget is passed. A short plan covers a slice, and
 *      pretending otherwise is the whole problem with most study plans, so the deferred
 *      list is part of the output.
 *   2. **"New problems", not "problems".** Each problem is assigned to the *first* page
 *      that claims its pattern, so a later page sharing that pattern shows 0 new ones.
 *      That page still needs studying — the count is new practice material, not effort.
 *
 * Usage:
 *
 *   import StudyPlanner from "../../../../components/dsa/StudyPlanner.astro";
 *
 *   <StudyPlanner weeks={8} hoursPerWeek={10} />
 *   <StudyPlanner weeks={6} hoursPerWeek={12} company="google" />
 */
import { buildStudyPlan, getCompany, syllabus } from "../../data/dsa";

interface Props {
  /** Weeks available. Default 8. */
  weeks?: number;
  /** Study hours per week — sets the per-week problem budget. Default 10. */
  hoursPerWeek?: number;
  /** Restrict to one company's pattern families. Omit for the general plan. */
  company?: string;
  /** Rough problems solved per study hour. Default 1 — deliberately conservative. */
  problemsPerHour?: number;
}

const { weeks = 8, hoursPerWeek = 10, company, problemsPerHour = 1 } = Astro.props;

const plan = buildStudyPlan({ weeks, hoursPerWeek, company, problemsPerHour });
const co = company ? getCompany(company) : undefined;
const unknownCompany = Boolean(company) && !co;

/**
 * How long the *whole* syllabus would take at this budget. Derived rather than written
 * down, because a hardcoded "57 weeks" would drift the moment a page is added.
 */
const fullPlan = buildStudyPlan({ weeks: 52 * 3, hoursPerWeek, problemsPerHour });
const fullWeeks = fullPlan.weeks.length;

const scheduledPages = plan.weeks.reduce((a, w) => a + w.pages.length, 0);
const consideredPages = scheduledPages + plan.deferred.length;
const pct = consideredPages > 0 ? Math.round((scheduledPages / consideredPages) * 100) : 0;
---

{
  unknownCompany ? (
    <aside class="pch-pl__missing">
      <strong>Unknown company</strong> <code>{company}</code>. Profiles live in
      <code>src/data/dsa/companies.yaml</code>.
    </aside>
  ) : (
    <div class="pch-sp">
      <p class="pch-sp__summary">
        <strong>{plan.weeks.length} weeks</strong> at {plan.options.hoursPerWeek} h/week
        {" — "}a budget of about <strong>{plan.problemBudget} problems</strong> per week.
        {co ? <> Filtered to <strong>{co.name}</strong>'s pattern families.</> : null}
        {" "}This schedules <strong>{scheduledPages} of {consideredPages}</strong> pattern
        pages ({pct}%) and <strong>{plan.totalProblems}</strong> problems.
      </p>

      <aside class="pch-sp__caveat">
        <strong>What this plan leaves out.</strong> The full syllabus is{" "}
        {syllabus.length} pattern pages, which at {plan.options.hoursPerWeek} h/week would take
        about <strong>{fullWeeks} weeks</strong>. A short plan is a <em>slice</em>, chosen in
        teaching order so the
        prerequisites hold — not a complete course. Everything it cannot fit is listed at the
        bottom rather than quietly dropped.
        {" "}The per-week counts are <strong>new</strong> problems: each problem is assigned to
        the first page that claims its pattern, so a later page can show 0 new ones and still
        need studying.
      </aside>

      <table class="pch-sp__table">
        <thead>
          <tr>
            <th>Week</th>
            <th>Focus</th>
            <th>New problems</th>
            <th>Mix</th>
          </tr>
        </thead>
        <tbody>
          {plan.weeks.map((w) => (
            <tr>
              <td class="pch-sp__wk">{w.week}</td>
              <td>
                <ul class="pch-sp__pages">
                  {w.pages.map((p) => (
                    <li>
                      <a href={p.url}>{p.title}</a>{" "}
                      <span class="pch-sp__phase">{p.phaseLabel}</span>
                    </li>
                  ))}
                </ul>
              </td>
              <td class="pch-sp__num">{w.problems.length}</td>
              <td class="pch-sp__mix">
                <span class="pch-sp__easy">{w.breakdown.easy}e</span>{" "}
                <span class="pch-sp__med">{w.breakdown.medium}m</span>{" "}
                <span class="pch-sp__hard">{w.breakdown.hard}h</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {plan.deferred.length > 0 ? (
        <details class="pch-sp__deferred">
          <summary>
            Not scheduled: {plan.deferred.length} pattern{" "}
            {plan.deferred.length === 1 ? "page" : "pages"} beyond week {plan.weeks.length}
          </summary>
          <p>
            These come next, in the same teaching order. Raise the weeks or the hours to pull
            them in — or leave them, and know exactly what you have not covered.
          </p>
          <ul class="pch-sp__deflist">
            {plan.deferred.map((p) => (
              <li>
                <a href={p.url}>{p.title}</a>{" "}
                <span class="pch-sp__phase">{p.phaseLabel}</span>
              </li>
            ))}
          </ul>
        </details>
      ) : (
        <p class="pch-sp__complete">
          Everything in scope fits inside {plan.weeks.length} weeks — nothing deferred.
        </p>
      )}
    </div>
  )
}

<style>
  .pch-sp {
    margin: 1.5rem 0;
  }

  .pch-sp__summary {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .pch-sp__caveat {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-inline-start: 3px solid var(--sl-color-orange);
    background-color: var(--sl-color-gray-6);
    border-radius: 0 0.35rem 0.35rem 0;
    font-size: var(--sl-text-xs);
    line-height: 1.55;
  }

  .pch-sp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }

  .pch-sp__table th,
  .pch-sp__table td {
    padding: 0.5rem 0.6rem;
    border-block-end: 1px solid var(--sl-color-hairline);
    text-align: start;
    vertical-align: top;
  }

  .pch-sp__wk {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }

  .pch-sp__num {
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .pch-sp__mix {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: var(--sl-text-xs);
  }

  .pch-sp__easy {
    color: var(--sl-color-green);
  }
  .pch-sp__med {
    color: var(--sl-color-orange);
  }
  .pch-sp__hard {
    color: var(--sl-color-red);
  }

  .pch-sp__pages,
  .pch-sp__deflist {
    margin: 0;
    padding-inline-start: 1rem;
  }

  .pch-sp__pages li,
  .pch-sp__deflist li {
    margin: 0.1rem 0;
  }

  .pch-sp__phase {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .pch-sp__deferred {
    margin-block-start: 1rem;
    font-size: var(--sl-text-sm);
  }

  .pch-sp__deferred summary {
    cursor: pointer;
    color: var(--sl-color-gray-2);
  }

  .pch-sp__complete {
    margin-block-start: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-green);
  }
</style>

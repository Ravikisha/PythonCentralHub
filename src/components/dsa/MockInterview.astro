---
/**
 * MockInterview (Astro wrapper) — picks the problem pool at build time.
 *
 * Only the five fields the island renders cross into the client bundle, not the
 * whole 446-row database. Premium problems are excluded because the reader
 * cannot open the statement, and a timed round on a problem you cannot read is
 * worse than no round at all.
 *
 * The island needs Pyodide, which is provided by `public/scripts/python-playground.js`
 * via `window.__pchPyodide`. That script is already loaded site-wide; if a layout
 * ever stops loading it, the Run button reports the problem rather than hanging.
 *
 * Usage:
 *
 *   import MockInterview from "../../../../components/dsa/MockInterview.astro";
 *
 *   <MockInterview />
 *   <MockInterview minutes={30} patterns={["sliding-window"]} />
 */
import Mock from "./MockInterview.tsx";
import { problems, problemsForPatterns } from "../../data/dsa";

interface Props {
  /** Round length. The four phase budgets scale with it. */
  minutes?: number;
  /** Restrict the pool to these pattern slugs. */
  patterns?: string[];
}

const { minutes = 45, patterns } = Astro.props as Props;

const source = patterns?.length ? problemsForPatterns(patterns) : problems;

const pool = source
  .filter((p) => !p.premium && p.slug)
  .map((p) => ({
    lc: p.lc ?? null,
    slug: p.slug,
    title: p.title,
    difficulty: p.difficulty,
    patterns: p.patterns ?? [],
  }));
---

{
  pool.length === 0 ? (
    <p><em>No problems matched that filter.</em></p>
  ) : (
    <Mock client:visible problems={pool} minutes={minutes} />
  )
}

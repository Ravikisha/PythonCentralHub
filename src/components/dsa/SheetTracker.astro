---
/**
 * SheetTracker — a full public study sheet, rendered from src/data/dsa.
 *
 * The point of holding NeetCode 150, Blind 75, LeetCode Top Interview 150 and
 * Striver's steps in one database is that a reader can work *one* list here and
 * see their progress against all of them, instead of keeping four browser tabs
 * and four mental checklists.
 *
 * Title-listed sheets (NeetCode, Blind, LC) render section by section in the
 * sheet's own order. Striver's sheets publish steps rather than LeetCode titles —
 * many of their problems are GeeksforGeeks links this site cannot resolve — so
 * those render as step -> the pattern pages here that cover it -> the problems.
 * That distinction is stated on the page rather than papered over.
 *
 * Usage:
 *
 *   import SheetTracker from "../../../../components/dsa/SheetTracker.astro";
 *
 *   <SheetTracker sheet="neetcode150" />
 */
import { getSheet, problemsForSheet, problemUrl } from "../../data/dsa";
import ProblemTable, { type Row } from "./ProblemTable";

interface Props {
  /** Sheet key from sheets.yaml: neetcode150, blind75, lc_top_interview_150, striver_a2z, striver_sde. */
  sheet: string;
  /** Collapse sections by default. On by default — 150 rows open at once is unusable. */
  collapsed?: boolean;
}

const { sheet: key, collapsed = true } = Astro.props;

const sheet = getSheet(key);
const sections = sheet ? problemsForSheet(key) : [];

const groups = sections
  .map((s) => ({
    title: `${s.section} · ${s.problems.length}`,
    rows: s.problems.map(
      (p): Row => ({
        lc: p.lc,
        slug: p.slug,
        title: p.title,
        difficulty: p.difficulty,
        premium: p.premium,
        url: problemUrl(p),
        // Sheet badges are noise inside a sheet's own page; company chips are not.
        companies: p.companies,
        freq: p.freq,
      }),
    ),
  }))
  .filter((g) => g.rows.length > 0);

const resolved = groups.reduce((n, g) => n + g.rows.length, 0);
const isStepMapped = sheet?.by === "step";
---

{
  !sheet ? (
    <aside class="pch-pl__missing">
      <strong>Unknown sheet</strong> <code>{key}</code>. Known keys are defined in
      {" "}
      <code>src/data/dsa/sheets.yaml</code>.
    </aside>
  ) : (
    <div class="pch-sheet">
      <header class="pch-sheet__head">
        <div>
          <h3 class="pch-sheet__name">{sheet.name}</h3>
          <p class="pch-sheet__by">
            by {sheet.author} ·{" "}
            <a href={sheet.url} target="_blank" rel="noopener noreferrer">
              original sheet
            </a>
          </p>
        </div>
        <span class="pch-sheet__count">{sheet.count} problems</span>
      </header>

      <p class="pch-sheet__blurb">{sheet.blurb}</p>

      {isStepMapped ? (
        <aside class="pch-sheet__note">
          <strong>How this one is mapped.</strong> {sheet.name} publishes{" "}
          <em>steps</em> rather than a LeetCode-only problem list, and a good
          number of its problems live on GeeksforGeeks or Coding Ninjas rather
          than LeetCode. So each step below is matched to the pages on this site
          that teach it, and the problems shown are this site's LeetCode
          equivalents for that step — close to the original, not identical to it.
          Follow the link above for the canonical list.
        </aside>
      ) : resolved < sheet.count ? (
        <aside class="pch-sheet__note">
          <strong>{resolved} of {sheet.count} resolved.</strong> The remaining{" "}
          {sheet.count - resolved} could not be matched to a row in the problem
          database — usually a renamed problem. Worth reporting.
        </aside>
      ) : null}

      <ProblemTable client:visible groups={groups} collapsible={collapsed} />
    </div>
  )
}

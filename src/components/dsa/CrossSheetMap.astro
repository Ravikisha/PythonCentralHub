---
/**
 * CrossSheetMap — the payoff of holding every study sheet in one database.
 *
 * The sheets overlap heavily but nobody publishes *how* heavily, so readers pick
 * one sheet, finish it, and then cannot tell how much of the next one they have
 * already covered. This answers that directly: which problems appear in the most
 * sheets at once, and therefore which small set of problems buys the most
 * coverage per hour spent.
 *
 * Usage:
 *
 *   import CrossSheetMap from "../../../../components/dsa/CrossSheetMap.astro";
 *
 *   <CrossSheetMap minSheets={3} />
 */
import { crossSheetOverlap, getSheet, problemUrl, problems, sheets } from "../../data/dsa";
import ProblemTable, { type Row } from "./ProblemTable";

interface Props {
  /** Only show problems appearing in at least this many sheets. Default 3. */
  minSheets?: number;
}

const { minSheets = 3 } = Astro.props;

const overlap = crossSheetOverlap(minSheets);
const sheetName = (key: string): string => getSheet(key)?.name ?? key;

/** Sheets that list problems by title — the step-mapped ones cannot be counted here. */
const titleSheets = sheets.filter((s) => s.sections);

/** Pairwise overlap: how many problems each pair of sheets shares. */
const pairs: { a: string; b: string; shared: number; aTotal: number }[] = [];
for (let i = 0; i < titleSheets.length; i++) {
  for (let j = i + 1; j < titleSheets.length; j++) {
    const a = titleSheets[i];
    const b = titleSheets[j];
    const shared = problems.filter((p) => p.sheets?.[a.key] && p.sheets?.[b.key]).length;
    pairs.push({ a: a.name, b: b.name, shared, aTotal: Math.min(a.count, b.count) });
  }
}

const rows: Row[] = overlap.map(({ problem, sheets: keys }) => ({
  lc: problem.lc,
  slug: problem.slug,
  title: problem.title,
  difficulty: problem.difficulty,
  premium: problem.premium,
  url: problemUrl(problem),
  sheets: keys.map(sheetName),
  companies: problem.companies,
  freq: problem.freq,
  note: `in ${keys.length} sheets`,
}));

/** Total distinct problems across every title-listed sheet. */
const union = problems.filter((p) =>
  titleSheets.some((s) => p.sheets?.[s.key]),
).length;
const sumOfCounts = titleSheets.reduce((n, s) => n + s.count, 0);
---

<div class="pch-xsheet">
  <div class="pch-xsheet__stat">
    <b>{sumOfCounts}</b>
    <span>problems listed across {titleSheets.length} sheets</span>
  </div>
  <div class="pch-xsheet__stat">
    <b>{union}</b>
    <span>distinct problems once duplicates are removed</span>
  </div>
  <div class="pch-xsheet__stat">
    <b>{Math.round((1 - union / sumOfCounts) * 100)}%</b>
    <span>of the combined list is duplication</span>
  </div>
  <div class="pch-xsheet__stat">
    <b>{overlap.length}</b>
    <span>problems appear in {minSheets} or more sheets</span>
  </div>
</div>

<p>
  Read the last figure first. Those {overlap.length} problems are what the
  sheet authors independently agree on, which makes them the highest-value
  problems on this site — and the ones to do before anything else, whichever
  sheet you eventually commit to.
</p>

<h3>How much any two sheets share</h3>

<table>
  <thead>
    <tr>
      <th>Sheet A</th>
      <th>Sheet B</th>
      <th>Shared</th>
      <th>Share of the smaller sheet</th>
    </tr>
  </thead>
  <tbody>
    {
      pairs
        .sort((x, y) => y.shared - x.shared)
        .map((p) => (
          <tr>
            <td>{p.a}</td>
            <td>{p.b}</td>
            <td>{p.shared}</td>
            <td>{Math.round((p.shared / p.aTotal) * 100)}%</td>
          </tr>
        ))
    }
  </tbody>
</table>

<h3>The consensus problems</h3>

<ProblemTable
  client:visible
  groups={[{ rows }]}
  caption={`Every problem below appears in at least ${minSheets} of the sheets. Finish these and you have covered the core of all of them simultaneously.`}
/>

<style>
  .pch-xsheet {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.7rem;
    margin: 1.4rem 0;
  }
  .pch-xsheet__stat {
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    background: var(--sl-color-black);
  }
  .pch-xsheet__stat b {
    display: block;
    font-size: 1.65rem;
    line-height: 1.1;
    color: var(--sl-color-accent-high);
    font-variant-numeric: tabular-nums;
  }
  .pch-xsheet__stat span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
</style>

---
/**
 * DrillDeck (Astro wrapper) — queries the generated Recall deck at build time
 * and hands the React island only the fields it renders.
 *
 * The deck is 1100 prompts across 139 pages, which is ~250 KB of prose. That is
 * fine to ship once for a page whose entire purpose is drilling, but it is why
 * this wrapper exists rather than importing the data inside the island: the
 * filtering props are resolved here, so a page that scopes the deck to one phase
 * ships one phase.
 *
 * Usage:
 *
 *   import DrillDeck from "../../../../components/dsa/DrillDeck.astro";
 *
 *   <DrillDeck />
 *   <DrillDeck phases={["Phase-05-Patterns-Arrays-and-Strings"]} />
 *   <DrillDeck patterns={["sliding-window", "two-pointers"]} />
 */
import Deck from "./DrillDeck.tsx";
import { buildDeck, recallPhases } from "../../data/dsa";

interface Props {
  /** Restrict to these phase directory names. Omit for the whole course. */
  phases?: string[];
  /** Restrict to cards claiming any of these pattern slugs. */
  patterns?: string[];
}

const { phases, patterns } = Astro.props as Props;

const items = buildDeck({ phases, patterns }).map((i) => ({
  key: i.key,
  kind: i.kind,
  label: i.label,
  text: i.text,
  cardId: i.cardId,
  cardTitle: i.cardTitle,
  phase: i.phase,
  url: i.url,
}));

// Only offer a phase in the filter if the current selection actually has cards
// from it — otherwise the reader can pick a phase and get an empty deck.
const present = [...new Set(items.map((i) => i.phase))].sort();
const options = phases?.length ? present : recallPhases.filter((p) => present.includes(p));
---

{
  items.length === 0 ? (
    <p>
      <em>No recall prompts matched. Re-run <code>npm run dsa:recall</code> after editing a page.</em>
    </p>
  ) : (
    <Deck client:visible items={items} phases={options} />
  )
}

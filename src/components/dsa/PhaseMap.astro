---
/**
 * PhaseMap — every phase as a card, with counts derived from the database.
 *
 * WHAT THIS IS *NOT* FOR
 * ----------------------
 * The roadmap page already carries a hand-written "What each phase is for" table, and that
 * table is better than anything generated: it names what each phase buys you and, crucially,
 * whether it is **skippable**. That is editorial judgement and it should stay hand-written.
 *
 * This complements it rather than replacing it, by supplying the two things prose cannot keep
 * in step with 145 pages: the live **page and problem counts** per phase, and a link straight
 * into each phase's first page. It also cannot silently omit a phase the way a hand-written
 * table can — the row list comes from the filesystem.
 *
 * Phases split into two groups because they are not the same kind of thing: the numbered
 * teaching sequence, and the reference surfaces (orientation, cheatsheets, strategy, problem
 * sets, company guides) that you dip into throughout rather than work through in order.
 *
 * Usage:
 *
 *   import PhaseMap from "../../../../components/dsa/PhaseMap.astro";
 *
 *   <PhaseMap />
 */
import { phases, problemsForPatterns } from "../../data/dsa";

const rows = phases.map((p) => ({
  ...p,
  problems: p.patterns.length > 0 ? problemsForPatterns(p.patterns).length : 0,
}));

const sequence = rows.filter((r) => r.inSyllabus);
const reference = rows.filter((r) => !r.inSyllabus);

const totalPages = rows.reduce((a, r) => a + r.pages, 0);
const seqProblems = new Set(
  sequence.flatMap((r) => problemsForPatterns(r.patterns).map((p) => p.slug)),
).size;
---

<div class="pch-pm">
  <p class="pch-pm__summary">
    <strong>{totalPages} pages</strong> across {rows.length} phases.
    The {sequence.length}-phase teaching sequence reaches{" "}
    <strong>{seqProblems} distinct problems</strong>; the rest are reference surfaces you dip
    into rather than work through.
  </p>

  <h4 class="pch-pm__head">The teaching sequence</h4>
  <p class="pch-pm__note">
    In order — later phases assume earlier ones. Phases 01 and 02 carry no problem ladders
    because they teach language and analysis rather than patterns.
  </p>
  <div class="pch-pm__grid">
    {
      sequence.map((r) => (
        <a class="pch-pm__card" href={r.firstPage?.url ?? "#"}>
          <span class="pch-pm__num">{r.number}</span>
          <span class="pch-pm__label">{r.label}</span>
          <span class="pch-pm__stats">
            {r.pages} {r.pages === 1 ? "page" : "pages"}
            {r.problems > 0 ? <> · {r.problems} problems</> : null}
          </span>
        </a>
      ))
    }
  </div>

  <h4 class="pch-pm__head">Reference and practice</h4>
  <p class="pch-pm__note">
    Not a sequence. Use these throughout — the cheatsheets the night before, the problem sets
    for mixed recognition practice, the company guides when a specific loop is imminent.
  </p>
  <div class="pch-pm__grid">
    {
      reference.map((r) => (
        <a class="pch-pm__card pch-pm__card--ref" href={r.firstPage?.url ?? "#"}>
          <span class="pch-pm__num">{r.number}</span>
          <span class="pch-pm__label">{r.label}</span>
          <span class="pch-pm__stats">
            {r.pages} {r.pages === 1 ? "page" : "pages"}
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .pch-pm {
    margin: 1.5rem 0;
  }

  .pch-pm__summary {
    margin: 0 0 1rem;
    font-size: var(--sl-text-sm);
  }

  .pch-pm__head {
    margin: 1.25rem 0 0.25rem;
    font-size: var(--sl-text-base);
  }

  .pch-pm__note {
    margin: 0 0 0.7rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  .pch-pm__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.5rem;
  }

  .pch-pm__card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.55rem;
    align-items: baseline;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.45rem;
    text-decoration: none;
    color: inherit;
  }

  .pch-pm__card:hover,
  .pch-pm__card:focus-visible {
    border-color: var(--sl-color-text-accent);
    background-color: var(--sl-color-gray-6);
  }

  .pch-pm__card--ref {
    border-style: dashed;
  }

  .pch-pm__num {
    grid-row: 1 / span 2;
    font-variant-numeric: tabular-nums;
    font-size: var(--sl-text-lg);
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }

  .pch-pm__label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .pch-pm__stats {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
</style>

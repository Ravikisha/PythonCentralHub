---
/**
 * /certificates — the learner's own issued certificates.
 *
 * Read from users/{uid}/stats/certificates, an index the `issueCertificate`
 * function maintains. The certificates collection itself allows `get` but not
 * `list`, so it cannot be enumerated for holders' names and addresses — which
 * is why this index exists rather than a query.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.authCertificates"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, nofollow" } }],
  }}
>
  <div class="pch-certs not-content" data-pch-certs>
    <p class="pch-auth__intro" data-pch-loading>{t("pch.authLoading")}</p>

    <div data-pch-signedout hidden>
      <p class="pch-auth__intro">{t("pch.authSignedOutNotice")}</p>
      <a class="pch-auth__secondary" href="/login?next=/certificates">{t("pch.authSignIn")}</a>
    </div>

    <p class="pch-auth__intro" data-pch-none hidden>{t("pch.certNone")}</p>

    <div data-pch-list></div>

    {/* Strings the script needs at runtime. */}
    <p hidden data-text-issued>{t("pch.certIssued")}</p>
    <p hidden data-text-score>{t("pch.certScore")}</p>
    <p hidden data-text-id>{t("pch.certId")}</p>
    <p hidden data-text-print>{t("pch.certPrint")}</p>
    <p hidden data-text-verify>{t("pch.certVerifyLink")}</p>
    <p hidden data-text-linkedin>{t("pch.certLinkedIn")}</p>
    <p hidden data-text-awarded>{t("pch.certAwarded")}</p>
    <p hidden data-text-org>Python Central Hub</p>
  </div>
</StarlightPage>

<script>
  interface CertIndexItem {
    certificateId: string;
    module: string;
    score: number;
    issuedAt: number;
  }

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const text = (sel: string) => $(sel)?.textContent?.trim() ?? "";

  const loading = $("[data-pch-loading]");
  const listEl = $("[data-pch-list]");

  /** Prefer the manifest's label; fall back to a de-slugged module name. */
  async function moduleLabels(): Promise<Record<string, string>> {
    try {
      const res = await fetch("/progress-manifest.json");
      if (!res.ok) return {};
      const data = (await res.json()) as { modules: { slug: string; label: string }[] };
      return Object.fromEntries(data.modules.map((m) => [m.slug, m.label]));
    } catch {
      return {};
    }
  }

  (async () => {
    const { currentUser } = await import("../lib/firebase/auth");
    const user = await currentUser();
    if (loading) loading.hidden = true;

    if (!user || user.isAnonymous) {
      $("[data-pch-signedout]")!.hidden = false;
      return;
    }

    const { doc, getDoc } = await import("firebase/firestore");
    const { getDb } = await import("../lib/firebase/client");
    const db = await getDb();

    const snap = await getDoc(doc(db, "users", user.uid, "stats", "certificates"));
    const items = ((snap.data()?.items ?? []) as CertIndexItem[]).sort(
      (a, b) => b.issuedAt - a.issuedAt
    );

    if (!items.length) {
      $("[data-pch-none]")!.hidden = false;
      return;
    }

    const labels = await moduleLabels();
    const holder = user.displayName || user.email || "";
    const highlight = new URLSearchParams(window.location.search).get("new");

    for (const item of items) {
      const label = labels[item.module] ?? item.module.replace(/-/g, " ");
      const issued = new Date(item.issuedAt);
      const url = `${window.location.origin}/verify?id=${item.certificateId}`;

      const card = document.createElement("article");
      card.className = "pch-cert";
      card.dataset.new = String(highlight === item.certificateId);

      const heading = document.createElement("p");
      heading.className = "pch-cert__awarded";
      heading.textContent = text("[data-text-awarded]");

      const name = document.createElement("p");
      name.className = "pch-cert__holder";
      name.textContent = holder;

      const module = document.createElement("p");
      module.className = "pch-cert__module";
      module.textContent = label;

      const meta = document.createElement("p");
      meta.className = "pch-cert__meta";
      meta.textContent =
        `${text("[data-text-score]")} ${item.score}%  ·  ` +
        `${text("[data-text-issued]")} ${issued.toLocaleDateString(
          document.documentElement.lang || undefined,
          { year: "numeric", month: "long", day: "numeric" }
        )}`;

      const id = document.createElement("p");
      id.className = "pch-cert__id";
      id.textContent = `${text("[data-text-id]")} ${item.certificateId}`;

      const actions = document.createElement("p");
      actions.className = "pch-cert__actions";

      const print = document.createElement("button");
      print.type = "button";
      print.className = "pch-auth__secondary";
      print.textContent = text("[data-text-print]");
      // Print rather than a rendered image: the browser's own "Save as PDF"
      // produces selectable, scalable output, and print CSS keeps one
      // certificate per sheet without a canvas pipeline to maintain.
      print.addEventListener("click", () => {
        document
          .querySelectorAll(".pch-cert--printing")
          .forEach((el) => el.classList.remove("pch-cert--printing"));
        card.classList.add("pch-cert--printing");
        document.body.dataset.printing = "1";
        window.print();
      });

      const verify = document.createElement("a");
      verify.className = "pch-auth__secondary";
      verify.href = `/verify?id=${item.certificateId}`;
      verify.textContent = text("[data-text-verify]");

      const linkedin = document.createElement("a");
      linkedin.className = "pch-auth__secondary";
      linkedin.rel = "noopener";
      linkedin.target = "_blank";
      linkedin.textContent = text("[data-text-linkedin]");
      const params = new URLSearchParams({
        startTask: "CERTIFICATION_NAME",
        name: `${label} — Python Central Hub`,
        organizationName: text("[data-text-org]"),
        issueYear: String(issued.getFullYear()),
        issueMonth: String(issued.getMonth() + 1),
        certId: item.certificateId,
        certUrl: url,
      });
      linkedin.href = `https://www.linkedin.com/profile/add?${params}`;

      actions.append(print, verify, linkedin);
      card.append(heading, name, module, meta, id, actions);
      listEl?.appendChild(card);
    }

    window.addEventListener("afterprint", () => {
      delete document.body.dataset.printing;
      document
        .querySelectorAll(".pch-cert--printing")
        .forEach((el) => el.classList.remove("pch-cert--printing"));
    });
  })();
</script>

---
/**
 * /profile — account details, data export and account deletion.
 *
 * Statically generated like every other page, so it renders a skeleton and
 * fills it in once Firebase reports who is signed in. Visitors who are not
 * signed in get a message and a link rather than a redirect, because a
 * redirect would fire before auth has finished restoring and would bounce
 * legitimate users out.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AuthMessages from "../components/auth/AuthMessages.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.authProfileTitle"),
    template: "splash",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex, nofollow" } }],
  }}
>
  <div class="pch-auth not-content">
    <p class="pch-auth__intro" data-pch-loading>{t("pch.authLoading")}</p>

    <div data-pch-signedout hidden>
      <p class="pch-auth__intro">{t("pch.authSignedOutNotice")}</p>
      <a class="pch-auth__submit" href="/login?next=/profile" style="display:inline-block;text-align:center;text-decoration:none">
        {t("pch.authSignIn")}
      </a>
    </div>

    <div data-pch-panel hidden>
      <dl class="pch-profile__meta">
        <dt>{t("pch.authEmail")}</dt>
        <dd>
          <span data-pch-email></span>
          <span class="pch-profile__badge" data-pch-verified></span>
        </dd>

        <dt>{t("pch.authSignedInWith")}</dt>
        <dd data-pch-providers></dd>

        <dt>{t("pch.authMemberSince")}</dt>
        <dd data-pch-since></dd>
      </dl>

      <form id="pch-profile-form" novalidate>
        <div class="pch-auth__field">
          <label for="pch-profile-name">{t("pch.authDisplayName")}</label>
          <input id="pch-profile-name" name="displayName" type="text" autocomplete="name" maxlength="80" />
        </div>
        <button type="submit" class="pch-auth__submit" data-pch-save>{t("pch.authSave")}</button>
      </form>

      <fieldset class="pch-prefs">
        <legend>{t("pch.prefsTitle")}</legend>

        <label class="pch-prefs__row">
          <input type="checkbox" data-pch-pref="leaderboard" />
          <span>
            <strong>{t("pch.prefLeaderboard")}</strong>
            <small>{t("pch.prefLeaderboardHint")}</small>
          </span>
        </label>

        <label class="pch-prefs__row">
          <input type="checkbox" data-pch-pref="digest" />
          <span>
            <strong>{t("pch.prefDigest")}</strong>
            <small>{t("pch.prefDigestHint")}</small>
          </span>
        </label>
      </fieldset>

      <p class="pch-auth__status" data-pch-status hidden></p>

      <p class="pch-auth__alt">
        <button type="button" class="pch-auth__secondary" data-pch-export>
          {t("pch.authExport")}
        </button>
      </p>

      <section class="pch-profile__danger">
        <h2>{t("pch.authDelete")}</h2>
        <p>{t("pch.authDeleteWarn")}</p>

        <div class="pch-auth__field">
          <label for="pch-delete-confirm">{t("pch.authDeleteConfirm")}</label>
          <input id="pch-delete-confirm" type="text" autocomplete="off" data-pch-delete-input />
        </div>

        <button type="button" data-pch-delete disabled>{t("pch.authDelete")}</button>
      </section>
    </div>

    <p hidden data-pch-saved>{t("pch.authSaved")}</p>
    <p hidden data-pch-deleted>{t("pch.authDeleted")}</p>
    <p hidden data-pch-verified-yes>{t("pch.authEmailVerified")}</p>
    <p hidden data-pch-verified-no>{t("pch.authEmailUnverified")}</p>

    <AuthMessages />
  </div>
</StarlightPage>

<script>
  import { messageFor, setStatus } from "../lib/auth/messages";

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const text = (sel: string) => $(sel)?.textContent?.trim() ?? "";

  const loading = $("[data-pch-loading]");
  const signedOut = $("[data-pch-signedout]");
  const panel = $("[data-pch-panel]");
  const status = $<HTMLElement>("[data-pch-status]");

  /** Provider ids are machine-readable; show something a person recognises. */
  const PROVIDER_LABELS: Record<string, string> = {
    "google.com": "Google",
    "github.com": "GitHub",
    password: "Email",
  };

  (async () => {
    const { currentUser } = await import("../lib/firebase/auth");
    const user = await currentUser();

    if (loading) loading.hidden = true;

    if (!user || user.isAnonymous) {
      if (signedOut) signedOut.hidden = false;
      return;
    }
    if (panel) panel.hidden = false;

    const emailEl = $("[data-pch-email]");
    if (emailEl) emailEl.textContent = user.email ?? "";

    const badge = $<HTMLElement>("[data-pch-verified]");
    if (badge) {
      badge.dataset.ok = String(user.emailVerified);
      badge.textContent = user.emailVerified
        ? text("[data-pch-verified-yes]")
        : text("[data-pch-verified-no]");
    }

    const providers = $("[data-pch-providers]");
    if (providers) {
      providers.textContent = user.providerData
        .map((p) => PROVIDER_LABELS[p.providerId] ?? p.providerId)
        .join(", ");
    }

    const since = $("[data-pch-since]");
    if (since && user.metadata.creationTime) {
      since.textContent = new Date(user.metadata.creationTime).toLocaleDateString(
        document.documentElement.lang || undefined,
        { year: "numeric", month: "long", day: "numeric" }
      );
    }

    const nameInput = $<HTMLInputElement>("#pch-profile-name");
    if (nameInput) nameInput.value = user.displayName ?? "";

    /* ---- preferences ---- */
    const { doc, getDoc, setDoc } = await import("firebase/firestore");
    const { getDb } = await import("../lib/firebase/client");
    const db = await getDb();
    const profileRef = doc(db, "users", user.uid);

    const settings = ((await getDoc(profileRef)).data()?.settings ?? {}) as Record<
      string,
      boolean
    >;

    document.querySelectorAll<HTMLInputElement>("[data-pch-pref]").forEach((box) => {
      const key = box.dataset.pchPref!;
      box.checked = settings[key] === true;

      box.addEventListener("change", async () => {
        box.disabled = true;
        setStatus(status, null);
        try {
          // Merged so one switch never clears the other.
          await setDoc(
            profileRef,
            { uid: user.uid, settings: { ...settings, [key]: box.checked } },
            { merge: true }
          );
          settings[key] = box.checked;

          // The leaderboard row is derived from server-side records, so ask
          // the function to recompute rather than writing a row here. Opting
          // out deletes the row, which is the same call.
          if (key === "leaderboard") {
            const { callApi } = await import("../lib/firebase/client");
            await callApi("publish-leaderboard");
          }
          setStatus(status, text("[data-pch-saved]"), "success");
        } catch (err) {
          box.checked = !box.checked; // the switch lied; put it back
          const { authErrorKey } = await import("../lib/firebase/auth");
          setStatus(status, messageFor(authErrorKey(err)), "error");
        } finally {
          box.disabled = false;
        }
      });
    });
  })();

  /* ---- save display name ---- */
  const form = document.getElementById("pch-profile-form") as HTMLFormElement | null;
  const save = $<HTMLButtonElement>("[data-pch-save]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    setStatus(status, null);
    const value = (form.elements.namedItem("displayName") as HTMLInputElement).value.trim();
    if (save) save.disabled = true;
    try {
      const { updateDisplayName } = await import("../lib/firebase/auth");
      await updateDisplayName(value);
      setStatus(status, text("[data-pch-saved]"), "success");
    } catch (err) {
      const { authErrorKey } = await import("../lib/firebase/auth");
      setStatus(status, messageFor(authErrorKey(err)), "error");
    } finally {
      if (save) save.disabled = false;
    }
  });

  /* ---- export ---- */
  $<HTMLButtonElement>("[data-pch-export]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    setStatus(status, null);
    try {
      const { exportUserData } = await import("../lib/firebase/auth");
      const data = await exportUserData();
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "python-central-hub-data.json";
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      const { authErrorKey } = await import("../lib/firebase/auth");
      setStatus(status, messageFor(authErrorKey(err)), "error");
    } finally {
      btn.disabled = false;
    }
  });

  /* ---- delete account ---- */
  const deleteInput = $<HTMLInputElement>("[data-pch-delete-input]");
  const deleteBtn = $<HTMLButtonElement>("[data-pch-delete]");

  // The button stays disabled until the confirmation word is typed exactly.
  // Deleting the account cannot be undone, so it takes a deliberate action
  // rather than a single stray click.
  deleteInput?.addEventListener("input", () => {
    if (deleteBtn) deleteBtn.disabled = deleteInput.value.trim() !== "DELETE";
  });

  deleteBtn?.addEventListener("click", async () => {
    deleteBtn.disabled = true;
    setStatus(status, null);
    try {
      const { deleteAccount } = await import("../lib/firebase/auth");
      await deleteAccount();
      setStatus(status, text("[data-pch-deleted]"), "success");
      window.setTimeout(() => (window.location.href = "/"), 1500);
    } catch (err) {
      const { authErrorKey } = await import("../lib/firebase/auth");
      setStatus(status, messageFor(authErrorKey(err)), "error");
      deleteBtn.disabled = false;
    }
  });
</script>

---
/**
 * /verify?id=XXXX-XXXX-XXXX — public certificate check.
 *
 * A query parameter rather than a route segment: the site is statically
 * generated, so a /verify/[certId] route could only exist for ids that were
 * known at build time, which is none of them.
 *
 * Open to everyone, signed in or not. A certificate nobody else can check is
 * not a credential, so `certificates/{id}` allows `get` publicly — and denies
 * `list`, so the collection cannot be swept for holders' names and addresses.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.verifyTitle"),
    template: "splash",
    pagefind: false,
  }}
>
  <div class="pch-verify not-content">
    <form class="pch-verify__form" id="pch-verify-form" novalidate>
      <div class="pch-auth__field">
        <label for="pch-verify-id">{t("pch.certId")}</label>
        <input
          id="pch-verify-id"
          name="id"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="XXXX-XXXX-XXXX"
        />
      </div>
      <button type="submit" class="pch-auth__submit">{t("pch.verifySubmit")}</button>
    </form>

    <p class="pch-auth__intro" data-pch-state hidden></p>

    <article class="pch-cert" data-pch-cert hidden>
      <p class="pch-cert__awarded" data-pch-awarded></p>
      <p class="pch-cert__holder" data-pch-holder></p>
      <p class="pch-cert__module" data-pch-module></p>
      <p class="pch-cert__meta" data-pch-meta></p>
      <p class="pch-cert__id" data-pch-id></p>
    </article>

    {/* Strings the script needs at runtime. */}
    <p hidden data-text-checking>{t("pch.verifyChecking")}</p>
    <p hidden data-text-valid>{t("pch.verifyValid")}</p>
    <p hidden data-text-unknown>{t("pch.verifyUnknown")}</p>
    <p hidden data-text-error>{t("pch.authErrGeneric")}</p>
    <p hidden data-text-awarded>{t("pch.certAwarded")}</p>
    <p hidden data-text-score>{t("pch.certScore")}</p>
    <p hidden data-text-issued>{t("pch.certIssued")}</p>
    <p hidden data-text-id>{t("pch.certId")}</p>
  </div>
</StarlightPage>

<script>
  interface Certificate {
    certificateId: string;
    holder: string;
    module: string;
    score: number;
    pagesCompleted: number;
    pagesTotal: number;
    issuedAt?: { toDate(): Date };
  }

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const text = (sel: string) => $(sel)?.textContent?.trim() ?? "";

  const form = document.getElementById("pch-verify-form") as HTMLFormElement | null;
  const input = document.getElementById("pch-verify-id") as HTMLInputElement | null;
  const state = $("[data-pch-state]");
  const cert = $("[data-pch-cert]");

  const say = (message: string, tone: "info" | "error" | "success" = "info") => {
    if (!state) return;
    state.textContent = message;
    state.dataset.tone = tone;
    state.hidden = false;
  };

  async function moduleLabel(slug: string): Promise<string> {
    try {
      const res = await fetch("/progress-manifest.json");
      if (!res.ok) return slug.replace(/-/g, " ");
      const data = (await res.json()) as { modules: { slug: string; label: string }[] };
      return data.modules.find((m) => m.slug === slug)?.label ?? slug.replace(/-/g, " ");
    } catch {
      return slug.replace(/-/g, " ");
    }
  }

  async function check(rawId: string) {
    const id = rawId.trim().toUpperCase();
    if (!id) return;

    if (cert) cert.hidden = true;
    say(text("[data-text-checking]"));

    try {
      const { doc, getDoc } = await import("firebase/firestore");
      const { getDb } = await import("../lib/firebase/client");
      const snap = await getDoc(doc(await getDb(), "certificates", id));

      if (!snap.exists()) {
        say(text("[data-text-unknown]"), "error");
        return;
      }

      const data = snap.data() as Certificate;
      const issued = data.issuedAt?.toDate?.();

      $("[data-pch-awarded]")!.textContent = text("[data-text-awarded]");
      $("[data-pch-holder]")!.textContent = data.holder;
      $("[data-pch-module]")!.textContent = await moduleLabel(data.module);
      $("[data-pch-meta]")!.textContent =
        `${text("[data-text-score]")} ${data.score}%` +
        (issued
          ? `  ·  ${text("[data-text-issued]")} ${issued.toLocaleDateString(
              document.documentElement.lang || undefined,
              { year: "numeric", month: "long", day: "numeric" }
            )}`
          : "");
      $("[data-pch-id]")!.textContent = `${text("[data-text-id]")} ${data.certificateId}`;

      say(text("[data-text-valid]"), "success");
      if (cert) cert.hidden = false;
    } catch (err) {
      console.error("[verify] lookup failed:", err);
      say(text("[data-text-error]"), "error");
    }
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (input) void check(input.value);
  });

  // A certificate is shared as a link, so an id in the URL checks itself.
  const fromUrl = new URLSearchParams(window.location.search).get("id");
  if (fromUrl) {
    if (input) input.value = fromUrl;
    void check(fromUrl);
  }
</script>

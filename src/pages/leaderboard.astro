---
/**
 * /leaderboard — the opt-in public standings.
 *
 * Entries are written only by the `publishLeaderboard` function, which
 * recomputes each total from server-side records. Nothing here is
 * self-reported, and nobody appears without switching it on in their profile.
 */
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t("pch.boardTitle"),
    template: "splash",
    pagefind: false,
  }}
>
  <div class="pch-board not-content">
    <p class="pch-auth__intro">{t("pch.boardIntro")}</p>

    <p data-pch-state hidden></p>

    <ol class="pch-board__list" data-pch-board></ol>

    <p class="pch-dash__actions">
      <a class="pch-auth__secondary" href="/profile">{t("pch.boardJoin")}</a>
    </p>

    <p hidden data-text-empty>{t("pch.boardEmpty")}</p>
    <p hidden data-text-error>{t("pch.authErrGeneric")}</p>
    <p hidden data-text-xp>{t("pch.levelXp")}</p>
  </div>
</StarlightPage>

<script>
  interface Entry {
    uid: string;
    displayName: string;
    photoURL?: string;
    xp: number;
    pages: number;
    certificates: number;
  }

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const text = (sel: string) => $(sel)?.textContent?.trim() ?? "";

  const list = $("[data-pch-board]");
  const state = $("[data-pch-state]");

  const say = (msg: string) => {
    if (!state) return;
    state.textContent = msg;
    state.hidden = false;
  };

  (async () => {
    try {
      const { collection, getDocs, orderBy, query, limit } = await import("firebase/firestore");
      const { getDb } = await import("../lib/firebase/client");

      const snap = await getDocs(
        query(collection(await getDb(), "leaderboard"), orderBy("xp", "desc"), limit(50))
      );

      if (snap.empty) {
        say(text("[data-text-empty]"));
        return;
      }

      const xpLabel = text("[data-text-xp]");
      let rank = 0;

      snap.forEach((doc) => {
        const entry = doc.data() as Entry;
        rank += 1;

        const li = document.createElement("li");
        li.className = "pch-board__row";

        const place = document.createElement("span");
        place.className = "pch-board__rank";
        place.textContent = String(rank);

        const name = document.createElement("span");
        name.className = "pch-board__name";
        // Display names come from other people's accounts, so they go in as
        // text and never as markup.
        name.textContent = entry.displayName;

        const score = document.createElement("span");
        score.className = "pch-board__xp";
        score.textContent = `${entry.xp} ${xpLabel}`;

        li.append(place, name, score);
        list?.appendChild(li);
      });
    } catch (err) {
      console.error("[leaderboard] load failed:", err);
      say(text("[data-text-error]"));
    }
  })();
</script>
